@using System.Security.Claims

<nav class="navbar navbar-expand navbar-dark navbar-custom">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        
        <!-- Nhóm bên trái: Nút Hamburger + Logo/Brand -->
        <div class="d-flex align-items-center">
            <AuthorizeView Context="authContext">
                <Authorized>
                    <button class="btn btn-outline-light me-3 border-0 d-flex align-items-center justify-content-center" 
                            type="button" 
                            @onclick="OnToggleSidebar" 
                            style="border-radius: 8px; background: rgba(255, 255, 255, 0.05); width: 38px; height: 38px; padding: 0;">
                        <i class="bi bi-list fs-4" style="color: #cbd5e1;"></i>
                    </button>
                </Authorized>
            </AuthorizeView>

            <a class="navbar-brand-custom" href="">
                <i class="bi bi-shield-lock-fill me-2 fs-4"></i> HRMS Portal
            </a>
        </div>

        <!-- Nhóm bên phải: Chuyển đổi trạng thái đăng nhập -->
        <AuthorizeView Context="authContext">
            <Authorized>
                <div class="d-flex align-items-center">
                    <!-- Profile Card rút gọn -->
                    <div class="profile-chip d-flex gap-2 align-items-center">
                        <div class="profile-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <span class="profile-name">@authContext.User.Identity?.Name</span>
                        <span class="profile-role-badge">
                            Role: @string.Join(", ", authContext.User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value))
                        </span>
                    </div>

                    <span class="divider-vertical"></span>

                    <!-- Nút Đăng xuất -->
                    <a class="btn-logout-nav" href="auth/logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                </div>
            </Authorized>

            <NotAuthorized>
                <!-- Nút Đăng nhập cho người dùng ẩn danh -->
                <a class="btn-login-nav" href="login">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                </a>
            </NotAuthorized>
        </AuthorizeView>
        
    </div>
</nav>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }
}
