@page "/auth/change-password"
@rendermode InteractiveServer
@using System.Security.Claims
@using HRMS.Application.DTOs
@using HRMS.Application.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Đổi mật khẩu — HRMS</PageTitle>

<div class="change-password-container">
    <div class="background-decor">
        <div class="circle circle-1"></div>
        <div class="circle circle-2"></div>
    </div>

    <div class="change-password-card">
        <div class="card-header text-center">
            <div class="logo-box">
                <span class="bi bi-key-fill"></span>
            </div>
            <h2>Đổi Mật Khẩu</h2>
            <p class="subtitle text-muted">Cập nhật mật khẩu để bảo vệ tài khoản cá nhân.</p>
        </div>

        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="alert alert-info-custom d-flex align-items-center mb-4 show-animation">
                <span class="bi bi-info-circle-fill me-2 fs-5"></span>
                <div>Để bảo mật thông tin cá nhân và phiếu lương, khuyến nghị bạn nên đổi mật khẩu mặc định ngay sau khi nhận tài khoản từ HR.</div>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger-custom d-flex align-items-center mb-4 show-animation">
                    <span class="bi bi-exclamation-octagon-fill me-2 fs-5"></span>
                    <div>@_errorMessage</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success-custom d-flex align-items-center mb-4 show-animation">
                    <span class="bi bi-check-circle-fill me-2 fs-5"></span>
                    <div>@_successMessage</div>
                </div>
            }

            <div class="form-group mb-3">
                <label for="currentPassword" class="form-label">Mật khẩu hiện tại</label>
                <div class="input-wrapper">
                    <span class="bi bi-shield-lock-fill input-icon"></span>
                    <InputText id="currentPassword" type="password" class="form-control-custom" placeholder="Nhập mật khẩu hiện tại" @bind-Value="_model.CurrentPassword" disabled="@_isLoading" />
                </div>
                <ValidationMessage For="@(() => _model.CurrentPassword)" class="error-text mt-1 d-block" />
            </div>

            <div class="form-group mb-3">
                <label for="newPassword" class="form-label">Mật khẩu mới</label>
                <div class="input-wrapper">
                    <span class="bi bi-key-fill input-icon"></span>
                    <InputText id="newPassword" type="password" class="form-control-custom" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" @bind-Value="_model.NewPassword" disabled="@_isLoading" />
                </div>
                <ValidationMessage For="@(() => _model.NewPassword)" class="error-text mt-1 d-block" />
            </div>

            <div class="form-group mb-4">
                <label for="confirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                <div class="input-wrapper">
                    <span class="bi bi-check2-circle input-icon"></span>
                    <InputText id="confirmPassword" type="password" class="form-control-custom" placeholder="Xác nhận lại mật khẩu mới" @bind-Value="_model.ConfirmPassword" disabled="@_isLoading" />
                </div>
                <ValidationMessage For="@(() => _model.ConfirmPassword)" class="error-text mt-1 d-block" />
            </div>

            <button type="submit" class="btn-submit" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Đang cập nhật...</span>
                }
                else
                {
                    <span>Cập nhật mật khẩu</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly ChangePasswordDto _model = new();
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;
    private int _accountId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out _accountId))
        {
            _errorMessage = "Không xác thực được phiên đăng nhập. Vui lòng đăng nhập lại.";
        }
    }

    private async Task HandleSubmit()
    {
        if (_accountId <= 0)
        {
            _errorMessage = "Vui lòng đăng nhập lại.";
            return;
        }

        _errorMessage = null;
        _successMessage = null;
        _isLoading = true;

        try
        {
            var success = await AuthService.ChangePasswordAsync(_accountId, _model.CurrentPassword, _model.NewPassword);
            if (success)
            {
                _successMessage = "Thay đổi mật khẩu thành công!";
                _model.CurrentPassword = string.Empty;
                _model.NewPassword = string.Empty;
                _model.ConfirmPassword = string.Empty;
            }
            else
            {
                _errorMessage = "Mật khẩu hiện tại không chính xác.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi hệ thống: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
