    }

    /* Alert Danger */
    .alert-danger-dark {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        color: #fca5a5;
        font-size: 0.9rem;
    }

    .validation-message {
        color: #f87171;
        font-size: 0.8rem;
        margin-top: 0.35rem;
        display: block;
    }

    .modal-footer-dark {
        background: rgba(20, 23, 38, 0.4);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        border-radius: 0 0 12px 12px;
    }

    .btn-secondary-dark {
        padding: 0.6rem 1.25rem;
        background: rgba(71, 85, 105, 0.3);
        border: 1px solid rgba(148, 163, 184, 0.3);
        color: #cbd5e1;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
    }

    .btn-secondary-dark:hover:not(:disabled) {
        background: rgba(71, 85, 105, 0.5);
        border-color: rgba(148, 163, 184, 0.5);
        transform: translateY(-1px);
    }

    .btn-secondary-dark:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-success-contract {
        padding: 0.6rem 1.5rem;
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.2) 0%, rgba(22, 163, 74, 0.2) 100%);
        border: 1px solid rgba(34, 197, 94, 0.4);
        color: #86efac;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
    }

    .btn-success-contract:hover:not(:disabled) {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.3) 0%, rgba(22, 163, 74, 0.3) 100%);
        border-color: rgba(34, 197, 94, 0.6);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.2);
    }

    .btn-success-contract:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .modal-dialog {
            margin: 1rem;
            max-width: calc(100% - 2rem);
        }

        .modal-body-dark {
            padding: 1.25rem 1rem;
        }
    }
</style>
