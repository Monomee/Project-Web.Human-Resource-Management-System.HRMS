        color: #93c5fd;
        font-size: 0.85rem;
        margin-top: 1rem;
    }

    .alert-info-contract strong {
        color: #60a5fa;
    }

    .alert-info-contract ul {
        font-size: 0.85rem;
        line-height: 1.6;
    }

    .alert-info-contract li {
        margin-bottom: 0.35rem;
    }

    .badge-pending-small {
        background: rgba(251, 191, 36, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(251, 191, 36, 0.3);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .badge-active-small {
        background: rgba(34, 197, 94, 0.15);
