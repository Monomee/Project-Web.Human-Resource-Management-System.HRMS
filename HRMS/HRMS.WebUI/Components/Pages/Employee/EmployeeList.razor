@page "/employees"
@rendermode InteractiveServer
@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs
@using HRMS.Domain.Exceptions
@using HRMS.WebUI.Components.Pages.Employee
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject IPositionService PositionService
@inject IRoleService RoleService
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,HRM,HR")]

<PageTitle>Danh sách Nhân viên</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="page-title">
                <i class="bi bi-people-fill me-2"></i>Quản lý Nhân sự
            </h2>
            <p class="page-subtitle">Quản lý thông tin và trạng thái làm việc của nhân viên</p>
        </div>
    </div>

    @if (employees == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-3 text-muted-light">Đang tải dữ liệu...</p>
        </div>
    }
    else if (!employees.Any())
    {
        <div class="alert alert-info-dark">
            <i class="bi bi-info-circle me-2"></i>Chưa có nhân viên nào trong hệ thống.
        </div>
    }
    else
    {
        <!-- Table Toolbar -->
        <div class="table-toolbar mb-3">
            <div class="toolbar-left">
                <div class="search-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" 
                           class="form-control search-input" 
                           placeholder="Tìm kiếm nhân viên (Tên, Mã NV, Email)" 
                           @bind="searchKeyword"
                           @bind:event="oninput"
                           @onkeyup="ApplyFilters" />
                    @if (!string.IsNullOrEmpty(searchKeyword))
                    {
                        <button class="btn-clear-search" @onclick="ClearSearch">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
            </div>

            <div class="toolbar-middle">
                <div class="filter-item">
                    <i class="bi bi-building filter-icon"></i>
                    <select class="form-select filter-select" @onchange="OnDepartmentFilterChanged">
                        <option value="">Tất cả phòng ban</option>
                        @foreach (var dept in GetUniqueDepartments())
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>
                <div class="filter-item">
                    <i class="bi bi-check-circle filter-icon"></i>
                    <select class="form-select filter-select" @onchange="OnStatusFilterChanged">
                        <option value="">Tất cả trạng thái</option>
                        <option value="true">Đang làm</option>
                        <option value="false">Đã nghỉ</option>
                    </select>
                </div>
            </div>

            <div class="toolbar-right">
                <button class="btn-add-new" @onclick="AddNewEmployee">
                    <i class="bi bi-plus-circle me-2"></i>Thêm nhân viên mới
                </button>
            </div>
        </div>

        <div class="card-dark">
            <div class="table-responsive">
                <table class="table-dark-custom">
                    <thead>
                        <tr>
                            <th style="width: 280px">Nhân viên</th>
                            <th style="width: 250px">Email</th>
                            <th style="width: 100px" class="text-center">Giới tính</th>
                            <th style="width: 180px">Phòng ban</th>
                            <th style="width: 180px">Chức vụ</th>
                            <th style="width: 130px" class="text-center">Trạng thái</th>
                            <th style="width: 120px" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in GetPaginatedEmployees())
                        {
                            <tr>
                                <td>
                                    <div class="employee-info-cell">
                                        <div class="employee-avatar">
                                            @GetInitials(emp.FullName)
                                        </div>
                                        <div class="employee-details">
                                            <div class="employee-name-primary">@emp.FullName</div>
                                            <div class="employee-code-secondary">@emp.EmployeeCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="employee-email">@emp.EmailCompany</span></td>
                                <td class="text-center">
                                    @if (emp.Gender.HasValue)
                                    {
                                        <span class="badge-dark @(emp.Gender.Value ? "badge-male" : "badge-female")">
                                            <i class="bi @(emp.Gender.Value ? "bi-gender-male" : "bi-gender-female") me-1"></i>
                                            @(emp.Gender.Value ? "Nam" : "Nữ")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted-light">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-dark badge-department">
                                        <i class="bi bi-building me-1"></i>@emp.DepartmentName
                                    </span>
                                </td>
                                <td><span class="position-text">@emp.PositionName</span></td>
                                <td class="text-center">
                                    @if (emp.Status)
                                    {
                                        <span class="badge-dark badge-active">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đang làm
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-dark badge-inactive">
                                            <i class="bi bi-dash-circle-fill me-1"></i>Đã nghỉ
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-icons">
                                        <button class="icon-btn icon-view" 
                                                @onclick="() => ViewDetail(emp.Id)"
                                                title="Xem chi tiết">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                        <button class="icon-btn icon-edit" 
                                                @onclick="() => EditEmployee(emp.Id)"
                                                title="Chỉnh sửa">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="icon-btn icon-pause" 
                                                @onclick="() => ToggleStatus(emp)" 
                                                disabled="@(isProcessing && processingUserId == emp.Id)"
                                                title="@(emp.Status ? "Tạm dừng" : "Kích hoạt")">
                                            @if (isProcessing && processingUserId == emp.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-pause-circle-fill"></i>
                                            }
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Component Enhanced -->
        @if (GetTotalCount() > 0)
        {
            <div class="pagination-wrapper">
                <!-- Left: Page Size Selector -->
                <div class="pagination-left">
                    <div class="page-size-selector">
                        <label class="page-size-label">Số dòng:</label>
                        <select class="page-size-dropdown" @onchange="OnPageSizeChanged">
                            <option value="10" selected="@(pageSize == 10)">10</option>
                            <option value="20" selected="@(pageSize == 20)">20</option>
                            <option value="50" selected="@(pageSize == 50)">50</option>
                            <option value="100" selected="@(pageSize == 100)">100</option>
                        </select>
                    </div>
                    <span class="pagination-text">
                        Hiển thị @GetStartIndex() đến @GetEndIndex() trên tổng số @GetTotalCount() nhân viên
                    </span>
                </div>
                
                <!-- Right: Page Navigation Controls -->
                <div class="pagination-controls">
                    <button class="pagination-btn" 
                            @onclick="FirstPage" 
                            disabled="@(currentPage == 1)"
                            title="Trang đầu">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                    <button class="pagination-btn" 
                            @onclick="PreviousPage" 
                            disabled="@(currentPage == 1)"
                            title="Trang trước">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    
                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);
                        
                        // Always show first page if not in range
                        if (startPage > 1)
                        {
                            <button class="pagination-btn" @onclick="() => GoToPage(1)">1</button>
                            if (startPage > 2)
                            {
                                <span class="pagination-ellipsis">...</span>
                            }
                        }
                        
                        // Show pages in range
                        for (int i = startPage; i <= endPage; i++)
                        {
                            var pageNum = i;
                            <button class="pagination-btn @(pageNum == currentPage ? "active" : "")" 
                                    @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }
                        
                        // Always show last page if not in range
                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <span class="pagination-ellipsis">...</span>
                            }
                            <button class="pagination-btn" @onclick="() => GoToPage(totalPages)">@totalPages</button>
                        }
                    }
                    
                    <button class="pagination-btn" 
                            @onclick="NextPage" 
                            disabled="@(currentPage == totalPages)"
                            title="Trang sau">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="pagination-btn" 
                            @onclick="LastPage" 
                            disabled="@(currentPage == totalPages)"
                            title="Trang cuối">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @alertClass mt-3">
                <i class="bi @(alertClass == "alert-success-dark" ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                @message
            </div>
        }
    }
</div>

<!-- Add Employee Modal -->
<AddEmployeeModal 
    IsOpen="@isAddModalOpen"
    OnClose="@CloseAddModal"
    OnSave="@HandleSaveNewEmployee"
    Departments="@departmentList"
    Positions="@positionList"
    Roles="@roleList" />

<!-- Edit Employee Modal -->
<EditEmployeeModal 
    IsOpen="@isEditModalOpen"
    OnClose="@CloseEditModal"
    OnSave="@HandleUpdateEmployee"
    EmployeeData="@selectedEmployee"
    Departments="@departmentList"
    Positions="@positionList"
    Roles="@roleList" />

<!-- Modal hiển thị lỗi Business Rule -->
@if (showBusinessErrorModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 1050;" @onclick="CloseModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true" style="z-index: 1051;">
            <div class="modal-content-dark">
                <div class="modal-header-dark bg-danger">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Lỗi
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <p class="mb-0">@businessErrorMessage</p>
                </div>
                <div class="modal-footer-dark">
                    <button type="button" class="btn btn-secondary-dark" @onclick="CloseModal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EmployeeDto>? employees;
    private string searchKeyword = string.Empty;
    private string selectedDepartment = string.Empty;
    private string selectedStatus = string.Empty;
    
    // Pagination variables
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)GetFilteredEmployees().Count() / pageSize);
    
    private bool isProcessing = false;
    private int? processingUserId = null;
    private string message = string.Empty;
    private string alertClass = string.Empty;
    private bool showBusinessErrorModal = false;
    private string businessErrorMessage = string.Empty;

    // Modal states
    private bool isAddModalOpen = false;
    private bool isEditModalOpen = false;
    private UpdateEmployeeDto? selectedEmployee = null;

    // Dropdown data for modals
    private List<DepartmentDto> departmentList = new();
    private List<PositionDto> positionList = new();
    private List<RoleDto> roleList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
        await LoadDropdownData();
    }

    private async Task LoadEmployees()
    {
        employees = await EmployeeService.GetEmployeesWithDetailsAsync();
    }

    private async Task LoadDropdownData()
    {
        // Load departments from service
        departmentList = await DepartmentService.GetAllAsync();
        
        // Load positions from service
        positionList = await PositionService.GetAllAsync();
        
        // Load roles from service
        roleList = await RoleService.GetAllAsync();
    }

    private IEnumerable<EmployeeDto> GetFilteredEmployees()
    {
        if (employees == null) return Enumerable.Empty<EmployeeDto>();

        var filtered = employees.AsEnumerable();

        // Search filter
        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            var keyword = searchKeyword.ToLower();
            filtered = filtered.Where(e => 
                e.FullName.ToLower().Contains(keyword) ||
                e.EmployeeCode.ToLower().Contains(keyword) ||
                e.EmailCompany.ToLower().Contains(keyword)
            );
        }

        // Department filter
        if (!string.IsNullOrWhiteSpace(selectedDepartment))
        {
            filtered = filtered.Where(e => e.DepartmentName == selectedDepartment);
        }

        // Status filter
        if (!string.IsNullOrWhiteSpace(selectedStatus))
        {
            bool status = selectedStatus == "true";
            filtered = filtered.Where(e => e.Status == status);
        }

        return filtered;
    }

    private IEnumerable<EmployeeDto> GetPaginatedEmployees()
    {
        var filtered = GetFilteredEmployees();
        return filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);
    }

    private int GetStartIndex()
    {
        var total = GetFilteredEmployees().Count();
        if (total == 0) return 0;
        return (currentPage - 1) * pageSize + 1;
    }

    private int GetEndIndex()
    {
        var total = GetFilteredEmployees().Count();
        var end = currentPage * pageSize;
        return Math.Min(end, total);
    }

    private int GetTotalCount()
    {
        return GetFilteredEmployees().Count();
    }

    private void FirstPage()
    {
        currentPage = 1;
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }

    private void LastPage()
    {
        currentPage = totalPages;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize))
        {
            pageSize = newPageSize;
            
            // Recalculate current page to avoid out of range
            int newTotalPages = (int)Math.Ceiling((double)GetFilteredEmployees().Count() / pageSize);
            if (currentPage > newTotalPages)
            {
                currentPage = Math.Max(1, newTotalPages);
            }
            
            StateHasChanged();
        }
    }

    private IEnumerable<string> GetUniqueDepartments()
    {
        if (employees == null) return Enumerable.Empty<string>();
        return employees.Select(e => e.DepartmentName).Distinct().OrderBy(d => d);
    }

    private void ApplyFilters()
    {
        currentPage = 1; // Reset to first page when filters change
        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchKeyword = string.Empty;
        currentPage = 1; // Reset to first page
        StateHasChanged();
    }

    private void OnDepartmentFilterChanged(ChangeEventArgs e)
    {
        selectedDepartment = e.Value?.ToString() ?? string.Empty;
        currentPage = 1; // Reset to first page
        StateHasChanged();
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? string.Empty;
        currentPage = 1; // Reset to first page
        StateHasChanged();
    }

    private void AddNewEmployee()
    {
        isAddModalOpen = true;
    }

    private void CloseAddModal()
    {
        isAddModalOpen = false;
        message = string.Empty;
    }

    private async Task HandleSaveNewEmployee(CreateEmployeeDto newEmployee)
    {
        try
        {
            // Call service to create employee
            var createdEmployee = await EmployeeService.CreateAsync(newEmployee);
            
            // Show success message
            message = $"Đã thêm nhân viên {createdEmployee.FullName} (Mã: {createdEmployee.EmployeeCode}) thành công.";
            alertClass = "alert-success-dark";
            
            // Close modal
            isAddModalOpen = false;
            
            // Reload employee list
            await LoadEmployees();
            
            // Reset to first page
            currentPage = 1;
        }
        catch (BusinessException ex)
        {
            businessErrorMessage = ex.Message;
            showBusinessErrorModal = true;
            isAddModalOpen = false;
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "alert-danger-dark";
            isAddModalOpen = false;
        }
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        
        var words = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 1) return words[0].Substring(0, Math.Min(2, words[0].Length)).ToUpper();
        
        // Lấy chữ cái đầu của tên cuối và tên đệm/tên đầu
        return (words[words.Length - 1].Substring(0, 1) + words[0].Substring(0, 1)).ToUpper();
    }

    private void ViewDetail(int employeeId)
    {
        Navigation.NavigateTo($"/employees/detail/{employeeId}");
    }

    private void EditEmployee(int employeeId)
    {
        var employee = employees?.FirstOrDefault(e => e.Id == employeeId);
        if (employee != null)
        {
            // Convert EmployeeDto to UpdateEmployeeDto
            selectedEmployee = new UpdateEmployeeDto
            {
                Id = employee.Id,
                EmployeeCode = employee.EmployeeCode,
                FullName = employee.FullName,
                EmailCompany = employee.EmailCompany,
                Phone = employee.Phone,
                Gender = employee.Gender,
                DepartmentId = employee.DepartmentId,
                PositionId = employee.PositionId,
                RoleId = roleList.FirstOrDefault()?.Id ?? 1, // Default to first role if available
                DateOfBirth = employee.DateOfBirth,
                Status = employee.Status
            };
            
            isEditModalOpen = true;
            message = string.Empty;
        }
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        selectedEmployee = null;
        message = string.Empty;
    }

    private async Task HandleUpdateEmployee(UpdateEmployeeDto updatedEmployee)
    {
        try
        {
            // Call service to update employee
            bool success = await EmployeeService.UpdateAsync(updatedEmployee);
            
            if (!success)
            {
                message = "Không tìm thấy nhân viên để cập nhật.";
                alertClass = "alert-danger-dark";
                isEditModalOpen = false;
                selectedEmployee = null;
                return;
            }
            
            // Update the employee in the list (for immediate UI update)
            var employee = employees?.FirstOrDefault(e => e.Id == updatedEmployee.Id);
            if (employee != null)
            {
                employee.FullName = updatedEmployee.FullName;
                employee.EmailCompany = updatedEmployee.EmailCompany;
                employee.Phone = updatedEmployee.Phone;
                employee.Gender = updatedEmployee.Gender;
                employee.DepartmentId = updatedEmployee.DepartmentId!.Value;
                employee.PositionId = updatedEmployee.PositionId!.Value;
                employee.DateOfBirth = updatedEmployee.DateOfBirth;
                employee.Status = updatedEmployee.Status;
                
                // Update department and position names
                var dept = departmentList.FirstOrDefault(d => d.Id == updatedEmployee.DepartmentId);
                var pos = positionList.FirstOrDefault(p => p.Id == updatedEmployee.PositionId);
                if (dept != null) employee.DepartmentName = dept.Name;
                if (pos != null) employee.PositionName = pos.Name;
            }
            
            message = $"Đã cập nhật thông tin nhân viên {updatedEmployee.FullName} thành công.";
            alertClass = "alert-success-dark";
            
            // Close modal
            isEditModalOpen = false;
            selectedEmployee = null;
            
            // Force UI update
            StateHasChanged();
        }
        catch (BusinessException ex)
        {
            businessErrorMessage = ex.Message;
            showBusinessErrorModal = true;
            isEditModalOpen = false;
            selectedEmployee = null;
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "alert-danger-dark";
            isEditModalOpen = false;
            selectedEmployee = null;
        }
    }

    private async Task ToggleStatus(EmployeeDto employee)
    {
        isProcessing = true;
        processingUserId = employee.Id;
        message = string.Empty;

        try
        {
            bool newStatus = !employee.Status;
            bool success = await EmployeeService.UpdateEmployeeStatusAsync(employee.Id, newStatus);

            if (success)
            {
                employee.Status = newStatus;
                message = $"Đã cập nhật trạng thái nhân viên {employee.FullName} thành công.";
                alertClass = "alert-success-dark";
            }
            else
            {
                message = "Không tìm thấy nhân viên để cập nhật.";
                alertClass = "alert-danger-dark";
            }
        }
        catch (BusinessException ex)
        {
            businessErrorMessage = ex.Message;
            showBusinessErrorModal = true;
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "alert-danger-dark";
        }
        finally
        {
            isProcessing = false;
            processingUserId = null;
        }
    }

    private void CloseModal()
    {
        showBusinessErrorModal = false;
        businessErrorMessage = string.Empty;
    }
}

<style>
    /* ============================================
       DARK THEME FOR EMPLOYEE MANAGEMENT
       ============================================ */
    
    /* Page Title */
    .page-title {
        color: #f1f5f9;
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #94a3b8;
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    /* ============================================
       TABLE TOOLBAR
       ============================================ */
    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px 12px 0 0;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .toolbar-left {
        flex: 1;
        max-width: 400px;
    }

    .toolbar-middle {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .toolbar-right {
        flex-shrink: 0;
    }

    /* Search Box */
    .search-box {
        position: relative;
        width: 100%;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 1rem;
        z-index: 1;
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding-left: 2.75rem;
        padding-right: 2.5rem;
        background: rgba(30, 41, 59, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #e2e8f0 !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .search-input:focus {
        background: rgba(30, 41, 59, 0.8) !important;
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .search-input::placeholder {
        color: #64748b;
    }

    .btn-clear-search {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 0.25rem;
        display: flex;
        align-items: center;
        transition: color 0.2s ease;
    }

    .btn-clear-search:hover {
        color: #ef4444;
    }

    

    /* Filter Items */
    .filter-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
