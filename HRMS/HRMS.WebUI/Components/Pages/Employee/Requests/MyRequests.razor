@page "/requests/my"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Microsoft.JSInterop
@using HRMS.Application.DTOs
@using HRMS.Application.Interfaces
@using HRMS.Domain.Entities
@using Microsoft.AspNetCore.SignalR.Client;
@inject IRequestService RequestService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Đơn của tôi</PageTitle>

<h3>Đơn từ của tôi</h3>

@if (!_accountResolved)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else
{

    <div class="card p-3 mb-4">
        <h5>@(_editingRequestId is null ? "Tạo đơn mới" : $"Sửa đơn nháp #{_editingRequestId}")</h5>

        @if (_requestTypes is null)
        {
            <p>Đang tải danh sách loại đơn...</p>
        }
        else
        {
            <EditForm Model="_newRequest">
                <div class="mb-2">
                    <label>Loại đơn</label>
                    <InputSelect class="form-select" @bind-Value="_newRequest.RequestTypeId">
                        <option value="0">-- Chọn loại đơn --</option>
                        @foreach (var t in _requestTypes)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </InputSelect>
                </div>

                @if (SelectedTypeCode == RequestTypeCodes.Leave)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label>Từ ngày</label>
                            <InputDate class="form-control" @bind-Value="_leaveStart" />
                        </div>
                        <div class="col">
                            <label>Đến ngày</label>
                            <InputDate class="form-control" @bind-Value="_leaveEnd" />
                        </div>
                    </div>
                }
                else if (SelectedTypeCode == RequestTypeCodes.Overtime)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label>Ngày làm OT</label>
                            <InputDate class="form-control" @bind-Value="_otDate" />
                        </div>
                        <div class="col">
                            <label>Số giờ OT</label>
                            <InputNumber class="form-control" @bind-Value="_newRequest.OvertimeHours" />
                        </div>
                    </div>
                }
                else if (SelectedTypeCode == RequestTypeCodes.Complaint)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label>Ngày công cần khiếu nại</label>
                            <InputDate class="form-control" @bind-Value="_complaintDate" />
                        </div>
                        <div class="col">
                            <label>Số giờ đề nghị</label>
                            <InputNumber class="form-control" @bind-Value="_newRequest.ComplaintProposedHours" />
                        </div>
                    </div>
                }

                <div class="mb-2">
                    <label>Lý do / Ghi chú</label>
                    <InputTextArea class="form-control" @bind-Value="_newRequest.Reason" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                @if (_editingRequestId is null)
                {
                    <button type="button" class="btn btn-outline-secondary me-2" disabled="@_isSubmitting" @onclick="() => HandleSubmit(false)">
                        Lưu nháp
                    </button>
                    <button type="button" class="btn btn-primary" disabled="@_isSubmitting" @onclick="() => HandleSubmit(true)">
                        @(_isSubmitting ? "Đang gửi..." : "Gửi đơn")
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-primary me-2" disabled="@_isSubmitting" @onclick="SaveDraftEdit">
                        @(_isSubmitting ? "Đang lưu..." : "Lưu thay đổi")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isSubmitting" @onclick="CancelEdit">
                        Huỷ sửa
                    </button>
                }
            </EditForm>
        }
    </div>

    <h5>Lịch sử đơn</h5>

    @if (_myRequests is null)
    {
        <p>Đang tải...</p>
    }
    else if (_myRequests.Count == 0)
    {
        <p class="text-muted">Chưa có đơn nào.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Loại đơn</th>
                    <th>Nội dung</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _myRequests)
                {
                    <tr>
                        <td>@r.RequestTypeName</td>
                        <td>@r.Summary</td>
                        <td><span class="badge @GetStatusBadgeClass(r.Status)">@GetStatusLabel(r.Status)</span></td>
                        <td>@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (r.Status == RequestStatuses.Draft)
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        disabled="@_cancellingIds.Contains(r.Id)"
                                        @onclick="() => StartEdit(r)">
                                    Sửa
                                </button>
                                <button class="btn btn-sm btn-outline-primary me-1"
                                        disabled="@_cancellingIds.Contains(r.Id)"
                                        @onclick="() => SubmitDraft(r.Id)">
                                    Gửi đơn
                                </button>
                            }
                            @if (r.Status == RequestStatuses.Draft || r.Status == RequestStatuses.Pending)
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@_cancellingIds.Contains(r.Id)"
                                        @onclick="() => CancelRequest(r.Id)">
                                    Huỷ đơn
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!string.IsNullOrEmpty(_cancelErrorMessage) && _myRequests is not null)
    {
        <div class="alert alert-danger mt-2">@_cancelErrorMessage</div>
    }
}

@code {
    private int AccountId;
    private bool _accountResolved;

    private RequestDto _newRequest = new();
    private DateOnly? _leaveStart;
    private DateOnly? _leaveEnd;
    private DateOnly? _otDate;
    private DateOnly? _complaintDate;

    private List<RequestTypeDto>? _requestTypes;
    private List<RequestListItemDto>? _myRequests;
    private string? _errorMessage;
    private bool _isSubmitting;
    private readonly HashSet<int> _cancellingIds = new();
    private string? _cancelErrorMessage;
    private int? _editingRequestId;

    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hubConnection;

    /// <summary>Code của loại đơn đang được chọn trong dropdown, dùng để hiển thị field tương ứng.</summary>
    private string? SelectedTypeCode =>
        _requestTypes?.FirstOrDefault(t => t.Id == _newRequest.RequestTypeId)?.Code?.ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(idClaim, out AccountId))
        {
            _errorMessage = "Không xác định được tài khoản đăng nhập. Vui lòng đăng nhập lại.";
            return;
        }

        _accountResolved = true;

        _requestTypes = await RequestService.GetRequestTypesAsync();
        await LoadRequestsAsync();

        _hubConnection = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/hubs/requests"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<RequestListItemDto>("RequestProcessed", async (updated) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadRequestsAsync();
                StateHasChanged();
            });
        });

        await _hubConnection.StartAsync();
        await _hubConnection.SendAsync("JoinEmployeeGroup", AccountId);
    }

    private async Task LoadRequestsAsync()
    {
        _myRequests = await RequestService.GetMyRequestsAsync(AccountId);
    }

    private async Task HandleSubmit(bool submitImmediately)
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            _newRequest.AccountId = AccountId;
            _newRequest.LeaveStartDate = _leaveStart;
            _newRequest.LeaveEndDate = _leaveEnd;
            _newRequest.OvertimeDate = _otDate;
            _newRequest.ComplaintWorkDate = _complaintDate;
            _newRequest.SubmitImmediately = submitImmediately;

            await RequestService.SubmitRequestAsync(_newRequest);
            _newRequest = new RequestDto();
            _leaveStart = _leaveEnd = _otDate = _complaintDate = null;
            await LoadRequestsAsync();
        }
        catch (Application.RequestWorkflowException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>Nạp dữ liệu 1 đơn Draft vào form để sửa.</summary>
    private void StartEdit(RequestListItemDto r)
    {
        _errorMessage = null;
        _editingRequestId = r.Id;

        _newRequest = new RequestDto
        {
            AccountId = AccountId,
            RequestTypeId = r.RequestTypeId,
            Title = r.Title,
            Reason = r.Reason,
            SubmitImmediately = false
        };

        _leaveStart = _leaveEnd = _otDate = _complaintDate = null;

        switch (r.RequestTypeCode.ToUpperInvariant())
        {
            case RequestTypeCodes.Leave:
                _leaveStart = DateOnly.FromDateTime(r.StartDate);
                _leaveEnd = DateOnly.FromDateTime(r.EndDate);
                break;

            case RequestTypeCodes.Overtime:
                _otDate = DateOnly.FromDateTime(r.StartDate);
                _newRequest.OvertimeHours = r.Value;
                break;

            case RequestTypeCodes.Complaint:
                _complaintDate = DateOnly.FromDateTime(r.StartDate);
                _newRequest.ComplaintProposedHours = r.Value;
                break;
        }
    }

    private void CancelEdit()
    {
        _editingRequestId = null;
        _errorMessage = null;
        _newRequest = new RequestDto();
        _leaveStart = _leaveEnd = _otDate = _complaintDate = null;
    }

    private async Task SaveDraftEdit()
    {
        if (_editingRequestId is null) return;

        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            _newRequest.AccountId = AccountId;
            _newRequest.LeaveStartDate = _leaveStart;
            _newRequest.LeaveEndDate = _leaveEnd;
            _newRequest.OvertimeDate = _otDate;
            _newRequest.ComplaintWorkDate = _complaintDate;

            await RequestService.UpdateDraftRequestAsync(_editingRequestId.Value, _newRequest);

            _editingRequestId = null;
            _newRequest = new RequestDto();
            _leaveStart = _leaveEnd = _otDate = _complaintDate = null;
            await LoadRequestsAsync();
        }
        catch (Application.RequestWorkflowException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitDraft(int requestId)
    {
        _cancelErrorMessage = null;
        _cancellingIds.Add(requestId);
        try
        {
            await RequestService.SubmitDraftRequestAsync(requestId, AccountId);
            await LoadRequestsAsync();
        }
        catch (Application.RequestWorkflowException ex)
        {
            _cancelErrorMessage = ex.Message;
        }
        finally
        {
            _cancellingIds.Remove(requestId);
        }
    }

    private async Task CancelRequest(int requestId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn huỷ đơn này không? Thao tác này không thể hoàn tác.");
        if (!confirmed) return;

        _cancelErrorMessage = null;
        _cancellingIds.Add(requestId);
        try
        {
            await RequestService.CancelRequestAsync(requestId, AccountId);
            await LoadRequestsAsync();
        }
        catch (Application.RequestWorkflowException ex)
        {
            _cancelErrorMessage = ex.Message;
        }
        finally
        {
            _cancellingIds.Remove(requestId);
        }
    }

    private static string GetStatusLabel(string status) => status switch
    {
        RequestStatuses.Draft => "Nháp",
        RequestStatuses.Pending => "Chờ duyệt",
        RequestStatuses.Approved => "Đã duyệt",
        RequestStatuses.Rejected => "Từ chối",
        RequestStatuses.Cancelled => "Đã huỷ",
        _ => status
    };

    private static string GetStatusBadgeClass(string status) => status switch
    {
        RequestStatuses.Draft => "bg-secondary",
        RequestStatuses.Pending => "bg-warning text-dark",
        RequestStatuses.Approved => "bg-success",
        RequestStatuses.Rejected => "bg-danger",
        RequestStatuses.Cancelled => "bg-dark",
        _ => "bg-light text-dark"
    };

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}
