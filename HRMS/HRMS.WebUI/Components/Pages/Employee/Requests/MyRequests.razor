@page "/requests/my"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

@using System.Security.Claims
@using HRMS.Application.DTOs
@using HRMS.Application.Interfaces
@using HRMS.Domain.Entities
@using Microsoft.AspNetCore.SignalR.Client

@inject IRequestService RequestService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>Đơn của tôi — HRMS</PageTitle>

<div class="my-requests-page animate-fade-in">
    @* Page Header *@
    <div class="page-header mb-4">
        <div class="page-header-icon"><i class="bi bi-file-earmark-plus fs-3"></i></div>
        <div>
            <h1 class="page-title text-white">Đơn từ của tôi</h1>
            <p class="page-subtitle text-muted-light">Tạo và theo dõi các đơn xin nghỉ phép, làm thêm giờ hoặc khiếu nại công.</p>
        </div>
    </div>

    @if (!_accountResolved)
    {
        <div class="alert alert-danger-custom mb-4">@_errorMessage</div>
    }
    else
    {
        @* Form Section *@
        <div class="card-dark-custom mb-5 shadow-sm">
            <div class="section-header-dark py-3 px-4">
                <h5 class="section-title m-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Tạo đơn mới</h5>
            </div>
            <div class="card-body-dark p-4">
                @if (_requestTypes is null)
                {
                    <p class="text-muted">Đang tải danh sách loại đơn...</p>
                }
                else
                {
                    <EditForm Model="_newRequest" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label-custom mb-2 d-block">Loại đơn</label>
                            <InputSelect class="form-select-custom" @bind-Value="_newRequest.RequestTypeId">
                                <option value="0">-- Chọn loại đơn --</option>
                                @foreach (var t in _requestTypes)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </InputSelect>
                        </div>

                        @if (SelectedTypeCode == RequestTypeCodes.Leave)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom mb-2 d-block">Từ ngày</label>
                                    <InputDate class="form-control-custom" @bind-Value="_leaveStart" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom mb-2 d-block">Đến ngày</label>
                                    <InputDate class="form-control-custom" @bind-Value="_leaveEnd" />
                                </div>
                            </div>
                        }
                        else if (SelectedTypeCode == RequestTypeCodes.Overtime)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom mb-2 d-block">Ngày làm OT</label>
                                    <InputDate class="form-control-custom" @bind-Value="_otDate" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom mb-2 d-block">Số giờ OT</label>
                                    <InputNumber class="form-control-custom" @bind-Value="_newRequest.OvertimeHours" />
                                </div>
                            </div>
                        }
                        else if (SelectedTypeCode == RequestTypeCodes.Complaint)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom mb-2 d-block">Ngày công cần khiếu nại</label>
                                    <InputDate class="form-control-custom" @bind-Value="_complaintDate" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom mb-2 d-block">Số giờ đề nghị</label>
                                    <InputNumber class="form-control-custom" @bind-Value="_newRequest.ComplaintProposedHours" />
                                </div>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label-custom mb-2 d-block">Lý do / Ghi chú</label>
                            <InputTextArea class="form-control-custom" rows="3" placeholder="Nhập lý do chi tiết..." @bind-Value="_newRequest.Reason" />
                        </div>

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger-custom mb-3">@_errorMessage</div>
                        }

                        <button type="submit" class="btn-primary-custom" disabled="@_isSubmitting">
                            @(_isSubmitting ? "Đang gửi..." : "Gửi đơn")
                        </button>
                    </EditForm>
                }
            </div>
        </div>

        @* Table Section *@
        <div class="card-dark-custom shadow-sm">
            <div class="section-header-dark py-3 px-4">
                <h5 class="section-title m-0"><i class="bi bi-clock-history me-2 text-primary"></i>Lịch sử đơn từ</h5>
            </div>
            <div class="card-body-dark p-0">
                @if (_myRequests is null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Đang tải lịch sử đơn...</p>
                    </div>
                }
                else if (_myRequests.Count == 0)
                {
                    <div class="text-center py-5 text-muted-dark">
                        <div class="fs-1 mb-3"><i class="bi bi-inbox-fill"></i></div>
                        <p>Chưa có đơn nào được tạo.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Loại đơn</th>
                                    <th>Nội dung</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th>Ngày tạo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _myRequests)
                                {
                                    <tr>
                                        <td class="fw-semibold text-white">@r.RequestTypeName</td>
                                        <td>@r.Summary</td>
                                        <td class="text-center">
                                            <span class="badge-status @GetStatusBadgeClass(r.Status)">
                                                @GetStatusLabel(r.Status)
                                            </span>
                                        </td>
                                        <td class="text-muted-light" style="font-family: monospace; font-size: 0.85rem;">
                                            @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private int AccountId;
    private bool _accountResolved;

    private RequestDto _newRequest = new();
    private DateOnly? _leaveStart;
    private DateOnly? _leaveEnd;
    private DateOnly? _otDate;
    private DateOnly? _complaintDate;

    private List<RequestTypeDto>? _requestTypes;
    private List<RequestListItemDto>? _myRequests;
    private string? _errorMessage;
    private bool _isSubmitting;

    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hubConnection;

    /// <summary>Code của loại đơn đang được chọn trong dropdown, dùng để hiển thị field tương ứng.</summary>
    private string? SelectedTypeCode =>
        _requestTypes?.FirstOrDefault(t => t.Id == _newRequest.RequestTypeId)?.Code?.ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(idClaim, out AccountId))
        {
            _errorMessage = "Không xác định được tài khoản đăng nhập. Vui lòng đăng nhập lại.";
            return;
        }

        _accountResolved = true;

        _requestTypes = await RequestService.GetRequestTypesAsync();
        await LoadRequestsAsync();

        _hubConnection = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/hubs/requests"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<RequestListItemDto>("RequestProcessed", async (updated) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadRequestsAsync();
                StateHasChanged();
            });
        });

        await _hubConnection.StartAsync();
        await _hubConnection.SendAsync("JoinEmployeeGroup", AccountId);
    }

    private async Task LoadRequestsAsync()
    {
        _myRequests = await RequestService.GetMyRequestsAsync(AccountId);
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            _newRequest.AccountId = AccountId;
            _newRequest.LeaveStartDate = _leaveStart;
            _newRequest.LeaveEndDate = _leaveEnd;
            _newRequest.OvertimeDate = _otDate;
            _newRequest.ComplaintWorkDate = _complaintDate;
            _newRequest.SubmitImmediately = true;

            await RequestService.SubmitRequestAsync(_newRequest);
            _newRequest = new RequestDto();
            _leaveStart = _leaveEnd = _otDate = _complaintDate = null;
            await LoadRequestsAsync();
        }
        catch (Application.RequestWorkflowException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string GetStatusLabel(string status) => status.ToUpperInvariant() switch
    {
        "DRAFT" => "Bản nháp",
        "PENDING" => "Chờ phê duyệt",
        "APPROVED" => "Đã phê duyệt",
        "REJECTED" => "Đã từ chối",
        "CANCELLED" => "Đã hủy",
        _ => status
    };

    private static string GetStatusBadgeClass(string status) => status.ToUpperInvariant() switch
    {
        "DRAFT" => "badge-status-draft",
        "PENDING" => "badge-status-pending",
        "APPROVED" => "badge-status-approved",
        "REJECTED" => "badge-status-rejected",
        "CANCELLED" => "badge-status-cancelled",
        _ => "badge-status-draft"
    };

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}
