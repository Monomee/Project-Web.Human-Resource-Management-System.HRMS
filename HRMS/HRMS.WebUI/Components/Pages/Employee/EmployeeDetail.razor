@page "/employees/detail/{id:int}"
@rendermode InteractiveServer
@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs
@using HRMS.Domain.Exceptions
@using HRMS.WebUI.Components.Pages.Employee
@using Microsoft.AspNetCore.Components.Authorization
@inject IEmployeeService EmployeeService
@inject IContractService ContractService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Executive,HRM,HR,Manager")]

<PageTitle>Chi tiết Nhân viên</PageTitle>

<div class="container-fluid mt-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/employees" style="text-decoration: none;">
                    <i class="bi bi-people-fill"></i> Danh sách Nhân viên
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    @if (employee == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col">
                <h2 class="text-primary">
                    <i class="bi bi-person-badge-fill"></i> Chi tiết Nhân viên: @employee.FullName
                </h2>
            </div>
        </div>

        <!-- PHẦN 1: HỒ SƠ CÁ NHÂN -->
        <div class="card-dark-custom shadow-sm mb-4">
            <div class="section-header-dark">
                <div class="section-title">
                    <i class="bi bi-person-circle me-2"></i>
                    <span>Thông tin Cá nhân</span>
                </div>
            </div>
            <div class="card-body-dark">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="info-grid">
                            <div class="info-row">
                                <span class="info-label">Mã nhân viên:</span>
                                <span class="info-value">
                                    <span class="badge-employee-code">@employee.EmployeeCode</span>
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Họ và tên:</span>
                                <span class="info-value info-highlight">@employee.FullName</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Giới tính:</span>
                                <span class="info-value">
                                    @if (employee.Gender.HasValue)
                                    {
                                        <span class="badge-dark @(employee.Gender.Value ? "badge-male" : "badge-female")">
                                            <i class="bi @(employee.Gender.Value ? "bi-gender-male" : "bi-gender-female") me-1"></i>
                                            @(employee.Gender.Value ? "Nam" : "Nữ")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted-dark">Chưa cập nhật</span>
                                    }
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Ngày sinh:</span>
                                <span class="info-value">
                                    @if (employee.DateOfBirth.HasValue)
                                    {
                                        @employee.DateOfBirth.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted-dark">Chưa cập nhật</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-grid">
                            <div class="info-row">
                                <span class="info-label">Email:</span>
                                <span class="info-value">
                                    <a href="mailto:@employee.EmailCompany" class="email-link">@employee.EmailCompany</a>
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Số điện thoại:</span>
                                <span class="info-value">@(employee.Phone ?? "Chưa cập nhật")</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Phòng ban:</span>
                                <span class="info-value">
                                    <span class="badge-dark badge-department">
                                        <i class="bi bi-building me-1"></i>
                                        @employee.DepartmentCode - @employee.DepartmentName
                                    </span>
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Chức vụ:</span>
                                <span class="info-value">
                                    <span class="badge-dark badge-position">
                                        <i class="bi bi-briefcase me-1"></i>
                                        @employee.PositionCode - @employee.PositionName
                                    </span>
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Trạng thái:</span>
                                <span class="info-value">
                                    @if (employee.Status)
                                    {
                                        <span class="badge-dark badge-status-active">
                                            <i class="bi bi-check-circle-fill me-1"></i>ĐANG LÀM VIỆC
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-dark badge-status-inactive">
                                            <i class="bi bi-x-circle-fill me-1"></i>ĐÃ NGHỈ VIỆC
                                        </span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PHẦN 2: DANH SÁCH HỢP ĐỒNG -->
        <div class="card-dark-custom shadow-sm">
            <div class="section-header-dark">
                <div class="section-title">
                    <i class="bi bi-file-earmark-text-fill me-2"></i>
                    <span>Lịch sử Hợp đồng Lao động</span>
                    <span class="badge-contract-count ms-2">@employee.Contracts.Count hợp đồng</span>
                </div>
                <!-- Only HR and HRM can create contract -->
                @if (isHrOrHrm)
                {
                    <button class="btn-add-contract" @onclick="OpenCreateContractModal">
                        <i class="bi bi-plus-circle me-2"></i>Thêm hợp đồng mới
                    </button>
                }
                else
                {
                    <span class="badge" style="background: rgba(100, 116, 139, 0.5); color: #cbd5e1; padding: 0.5rem 1rem; font-size: 0.9rem;">
                        <i class="bi bi-eye me-1"></i>Chế độ xem
                    </span>
                }
            </div>
            <div class="card-body-dark">
                @if (!employee.Contracts.Any())
                {
                    <div class="alert-warning-dark">
                        <i class="bi bi-exclamation-triangle me-2"></i>Nhân viên này chưa có hợp đồng nào.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-contract-header">
                                <tr>
                                    <th>Số hợp đồng</th>
                                    <th>Loại hợp đồng</th>
                                    <th>Ngày bắt đầu</th>
                                    <th>Ngày kết thúc</th>
                                    <th class="text-end">Lương cơ bản</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th style="min-width: 180px;">Lý do</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var contract in employee.Contracts)
                                {
                                    <tr class="@(contract.IsActive ? "table-success" : "")">
                                        <td>
                                            <strong>@contract.ContractNo</strong>
                                            @if (contract.IsActive)
                                            {
                                                <span class="badge bg-success ms-1">
                                                    <i class="bi bi-star-fill"></i> Hiện tại
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(contract.ContractType == "Official" ? "bg-primary" : "bg-warning text-dark")">
                                                @contract.ContractType
                                            </span>
                                        </td>
                                        <td>@contract.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (contract.EndDate.HasValue)
                                            {
                                                @contract.EndDate.Value.ToString("dd/MM/yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">Không xác định</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <strong class="salary-amount">
                                                @contract.BaseSalary.ToString("N0") VNĐ
                                            </strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge-dark @contract.StatusBadgeClass">
                                                <i class="bi @(contract.StatusEnum == HRMS.Domain.Enums.ContractStatus.Active ? "bi-check-circle-fill" : 
                                                             contract.StatusEnum == HRMS.Domain.Enums.ContractStatus.Pending ? "bi-clock-fill" :
                                                             contract.StatusEnum == HRMS.Domain.Enums.ContractStatus.Rejected ? "bi-x-circle-fill" :
                                                             contract.StatusEnum == HRMS.Domain.Enums.ContractStatus.Terminated ? "bi-pause-circle-fill" :
                                                             "bi-file-earmark") me-1"></i>
                                                @contract.StatusDisplayName
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(contract.Reason))
                                            {
                                                <span class="reason-badge" title="@contract.Reason">
                                                    <i class="bi bi-chat-left-text me-1"></i>
                                                    @(contract.Reason.Length > 50 ? contract.Reason.Substring(0, 50) + "..." : contract.Reason)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (contract.Status == "Pending")
                                            {
                                                <!-- Pending: HR/HRM can Edit, only HRM can Approve/Reject -->
                                                @if (isHrOrHrm)
                                                {
                                                    <div class="btn-action-group">
                                                        <button class="btn-edit-contract" @onclick="() => OpenEditContractModal(contract)" title="Chỉnh sửa hợp đồng">
                                                            <i class="bi bi-pencil-fill"></i>
                                                        </button>
                                                        @if (isHrm)
                                                        {
                                                            <button class="btn-approve-contract" @onclick="() => OpenApproveModal(contract)" title="Phê duyệt">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button class="btn-reject-contract" @onclick="() => OpenRejectModal(contract)" title="Từ chối">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted-dark">Chỉ xem</span>
                                                }
                                            }
                                            else if (contract.Status == "Rejected")
                                            {
                                                <!-- Rejected: HR/HRM can Edit to resubmit -->
                                                @if (isHrOrHrm)
                                                {
                                                    <button class="btn-edit-contract" @onclick="() => OpenEditContractModal(contract)" title="Chỉnh sửa hợp đồng">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted-dark">Chỉ xem</span>
                                                }
                                            }
                                            else if (contract.Status == "Active")
                                            {
                                                <!-- Active: HRM can Terminate/Deactivate -->
                                                @if (isHrm)
                                                {
                                                    <div class="btn-action-group">
                                                        <button class="btn-terminate-contract" @onclick="() => OpenTerminateModal(contract)" title="Chấm dứt hợp đồng">
                                                            <i class="bi bi-stop-circle-fill"></i>
                                                        </button>
                                                        <button class="btn-deactivate-contract" @onclick="() => OpenDeactivateModal(contract)" title="Vô hiệu hóa">
                                                            <i class="bi bi-pause-circle-fill"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted-dark">Chỉ xem</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted-dark">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Thống kê tóm tắt -->
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Tổng số hợp đồng</h6>
                                    <h3 class="text-primary">@employee.Contracts.Count</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Hợp đồng đang hoạt động</h6>
                                    <h3 class="text-success">@employee.Contracts.Count(c => c.IsActive)</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Lương hiện tại</h6>
                                    <h3 class="text-success">
                                        @{
                                            var activeContract = employee.Contracts.FirstOrDefault(c => c.IsActive);
                                            if (activeContract != null)
                                            {
                                                @activeContract.BaseSalary.ToString("N0")
                                                <small>VNĐ</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        }
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Nút Quay lại -->
        <div class="mt-4">
            <button class="btn btn-secondary" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Quay lại Danh sách
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success-dark alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close-success" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }
</div>

<!-- Create Contract Modal -->
<CreateContractModal 
    IsOpen="@isCreateContractModalOpen"
    UserId="@Id"
    OnClose="@CloseCreateContractModal"
    OnSave="@HandleContractCreated" />

<!-- Edit Contract Modal -->
<EditContractModal 
    IsOpen="@isEditContractModalOpen"
    ContractData="@selectedContract"
    OnClose="@CloseEditContractModal"
    OnSave="@HandleContractUpdated" />

<!-- Approve Contract Modal -->
@if (showApproveModal && selectedContract != null)
{
    <div class="modal fade show d-block modal-backdrop-click" tabindex="-1" @onclick="CloseApproveModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content-dark">
                <div class="modal-header-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-check-circle text-success me-2"></i>
                        Phê duyệt hợp đồng
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <p>Bạn có chắc chắn muốn phê duyệt hợp đồng <strong>@selectedContract.ContractNo</strong> không?</p>
                    <p class="text-muted-small">Sau khi phê duyệt, hợp đồng sẽ chuyển sang trạng thái <strong class="text-success">Hiệu lực</strong>.</p>
                </div>
                <div class="modal-footer-dark">
                    <button class="btn btn-secondary-dark" @onclick="CloseApproveModal" disabled="@isProcessing">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button class="btn btn-success-modal" @onclick="ConfirmApprove" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle me-1"></i>
                            <span>Phê duyệt</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Reject Contract Modal -->
@if (showRejectModal && selectedContract != null)
{
    <div class="modal fade show d-block modal-backdrop-click" tabindex="-1" @onclick="CloseRejectModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content-dark">
                <div class="modal-header-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-x-circle text-danger me-2"></i>
                        Từ chối hợp đồng
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <p>Bạn có chắc chắn muốn từ chối hợp đồng <strong>@selectedContract.ContractNo</strong> không?</p>
                    <div class="form-group-dark">
                        <label class="form-label-dark">Lý do từ chối (tùy chọn):</label>
                        <textarea class="form-control-dark" rows="3" @bind="rejectReason" placeholder="Nhập lý do từ chối..."></textarea>
                    </div>
                    <p class="text-muted-small mt-2">Sau khi từ chối, hợp đồng có thể được chỉnh sửa và gửi lại.</p>
                </div>
                <div class="modal-footer-dark">
                    <button class="btn btn-secondary-dark" @onclick="CloseRejectModal" disabled="@isProcessing">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button class="btn btn-danger-modal" @onclick="ConfirmReject" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <i class="bi bi-x-circle me-1"></i>
                            <span>Từ chối</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Terminate Contract Modal -->
@if (showTerminateModal && selectedContract != null)
{
    <div class="modal fade show d-block modal-backdrop-click" tabindex="-1" @onclick="CloseTerminateModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content-dark">
                <div class="modal-header-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-stop-circle text-warning me-2"></i>
                        Chấm dứt hợp đồng
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <p>Bạn có chắc chắn muốn chấm dứt hợp đồng <strong>@selectedContract.ContractNo</strong> không?</p>
                    <div class="form-group-dark">
                        <label class="form-label-dark">Lý do chấm dứt (tùy chọn):</label>
                        <textarea class="form-control-dark" rows="3" @bind="terminateReason" placeholder="Nhập lý do chấm dứt..."></textarea>
                    </div>
                    <p class="text-danger-small mt-2"><strong>Lưu ý:</strong> Hợp đồng sau khi chấm dứt sẽ kết thúc vào ngày hôm nay.</p>
                </div>
                <div class="modal-footer-dark">
                    <button class="btn btn-secondary-dark" @onclick="CloseTerminateModal" disabled="@isProcessing">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button class="btn btn-warning-modal" @onclick="ConfirmTerminate" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <i class="bi bi-stop-circle me-1"></i>
                            <span>Chấm dứt</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Deactivate Contract Modal -->
@if (showDeactivateModal && selectedContract != null)
{
    <div class="modal fade show d-block modal-backdrop-click" tabindex="-1" @onclick="CloseDeactivateModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content-dark">
                <div class="modal-header-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-pause-circle text-info me-2"></i>
                        Vô hiệu hóa hợp đồng
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <p>Bạn có chắc chắn muốn vô hiệu hóa hợp đồng <strong>@selectedContract.ContractNo</strong> không?</p>
                    <div class="form-group-dark">
                        <label class="form-label-dark">Lý do vô hiệu hóa (tùy chọn):</label>
                        <textarea class="form-control-dark" rows="3" @bind="deactivateReason" placeholder="Nhập lý do vô hiệu hóa..."></textarea>
                    </div>
                    <p class="text-info-small mt-2"><strong>Lưu ý:</strong> Hợp đồng sẽ chuyển sang trạng thái "Đã vô hiệu hóa" và không còn hiệu lực.</p>
                </div>
                <div class="modal-footer-dark">
                    <button class="btn btn-secondary-dark" @onclick="CloseDeactivateModal" disabled="@isProcessing">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button class="btn btn-info-modal" @onclick="ConfirmDeactivate" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <i class="bi bi-pause-circle me-1"></i>
                            <span>Vô hiệu hóa</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EmployeeDetailDto? employee;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isCreateContractModalOpen = false;
    private bool isEditContractModalOpen = false;
    private ContractDto? selectedContract = null;

    // Approval workflow modals
    private bool showApproveModal = false;
    private bool showRejectModal = false;
    private bool showTerminateModal = false;
    private bool showDeactivateModal = false;
    private bool isProcessing = false;
    private string rejectReason = string.Empty;
    private string terminateReason = string.Empty;
    private string deactivateReason = string.Empty;

    // Current user role tracking
    private string currentUserRole = string.Empty;
    private bool isHrOrHrm = false; // HR or HRM
    private bool isHrm = false;     // HRM only

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeeDetail();
        await LoadCurrentUser();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            if (user.Identity?.IsAuthenticated == true)
            {
                // Get Role
                var roleClaim = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role);
                if (roleClaim != null)
                {
                    currentUserRole = roleClaim.Value;
                    isHrm = (currentUserRole == "HRM");
                    isHrOrHrm = (currentUserRole == "HR" || currentUserRole == "HRM");
                }
            }
        }
        catch
        {
