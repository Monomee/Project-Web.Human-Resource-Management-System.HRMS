    }

    /* Alert Warning Contract */
    .alert-warning-contract {
        background: rgba(251, 191, 36, 0.08);
        border: 1px solid rgba(251, 191, 36, 0.2);
        border-radius: 8px;
        padding: 1rem;
        color: #fcd34d;
        font-size: 0.85rem;
        margin-top: 1rem;
    }

    .alert-warning-contract strong {
        color: #fbbf24;
    }

    .alert-warning-contract ul {
        font-size: 0.85rem;
        line-height: 1.6;
    }

    .alert-warning-contract li {
        margin-bottom: 0.35rem;
    }

    .alert-danger-dark {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        color: #fca5a5;
        font-size: 0.9rem;
    }

    .validation-message {
        color: #f87171;
        font-size: 0.8rem;
        margin-top: 0.35rem;
        display: block;
    }

    .modal-footer-dark {
        background: rgba(20, 23, 38, 0.4);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        border-radius: 0 0 12px 12px;
    }

    .btn-secondary-dark {
        padding: 0.6rem 1.25rem;
        background: rgba(71, 85, 105, 0.3);
        border: 1px solid rgba(148, 163, 184, 0.3);
        color: #cbd5e1;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
    }

    .btn-secondary-dark:hover:not(:disabled) {
        background: rgba(71, 85, 105, 0.5);
        border-color: rgba(148, 163, 184, 0.5);
        transform: translateY(-1px);
    }

    .btn-secondary-dark:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-warning-contract {
        padding: 0.6rem 1.5rem;
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.2) 0%, rgba(245, 158, 11, 0.2) 100%);
        border: 1px solid rgba(251, 191, 36, 0.4);
        color: #fcd34d;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
    }

    .btn-warning-contract:hover:not(:disabled) {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.3) 0%, rgba(245, 158, 11, 0.3) 100%);
        border-color: rgba(251, 191, 36, 0.6);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(251, 191, 36, 0.2);
    }

    .btn-warning-contract:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    @@media (max-width: 768px) {
        .modal-dialog {
            margin: 1rem;
            max-width: calc(100% - 2rem);
        }

        .modal-body-dark {
            padding: 1.25rem 1rem;
        }
    }
</style>
