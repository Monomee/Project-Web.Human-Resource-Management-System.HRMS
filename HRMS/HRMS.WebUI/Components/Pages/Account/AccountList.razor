@page "/accounts"
@rendermode InteractiveServer
@inject IAccountService AccountService
@inject IEmployeeService EmployeeService  
@inject IRoleService RoleService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@using HRMS.Application.Helpers
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Executive,HRM,HR,Manager")]

<PageTitle>Quản lý Tài khoản</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 style="color: #f1f5f9; font-size: 1.75rem; font-weight: 600;">
                <i class="bi bi-person-badge-fill me-2"></i>Quản lý Tài khoản
            </h2>
            <p style="color: #94a3b8; font-size: 0.95rem;">Quản lý thông tin đăng nhập và phân quyền người dùng</p>
        </div>
    </div>

    @if (accounts == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3" style="color: #94a3b8;">Đang tải dữ liệu...</p>
        </div>
    }
    else
    {
        <div class="card" style="background: rgba(20, 23, 38, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px;">
            <div class="card-body">
                <!-- Filter Section -->
                <div class="row mb-4" style="background: rgba(30, 41, 59, 0.3); padding: 1.25rem; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <div class="col-md-4 mb-3">
                        <label class="form-label" style="color: #cbd5e1; font-size: 0.875rem; font-weight: 500;">
                            <i class="bi bi-search me-1"></i>Tìm kiếm
                        </label>
                        <input type="text" class="form-control" @bind="searchKeyword" @bind:event="oninput" 
                               placeholder="Username, nhân viên, email..." 
                               style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); color: #e2e8f0;" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label" style="color: #cbd5e1; font-size: 0.875rem; font-weight: 500;">
                            <i class="bi bi-shield-check me-1"></i>Vai trò
                        </label>
                        <select class="form-select" @bind="filterRoleId" 
                                style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); color: #e2e8f0;">
                            <option value="">-- Tất cả vai trò --</option>
                            @if (roles != null)
                            {
                                @foreach (var role in roles)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label" style="color: #cbd5e1; font-size: 0.875rem; font-weight: 500;">
                            <i class="bi bi-toggle-on me-1"></i>Trạng thái
                        </label>
                        <select class="form-select" @bind="filterStatus" 
                                style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); color: #e2e8f0;">
                            <option value="">-- Tất cả --</option>
                            <option value="true">Hoạt động</option>
                            <option value="false">Khóa</option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-3 d-flex align-items-end">
                        <button class="btn btn-secondary w-100" @onclick="ClearFilters" 
                                style="background: rgba(71, 85, 105, 0.3); border: 1px solid rgba(148, 163, 184, 0.3); color: #cbd5e1;">
                            <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    @if (currentUserAccount != null && AuthorizationHelper.CanCreateAccount(currentUserAccount))
                    {
                        <button class="btn btn-primary" @onclick="ShowCreateModal">
                            <i class="bi bi-plus-circle me-2"></i>Thêm tài khoản mới
                        </button>
                    }
                    <span class="ms-3" style="color: #94a3b8; font-size: 0.9rem;">
                        Tổng số: <strong style="color: #60a5fa;">@filteredAccounts.Count()</strong> tài khoản
                        @if (currentUserAccount == null || !AuthorizationHelper.CanCreateAccount(currentUserAccount))
                        {
                            <span class="badge" style="background: rgba(100, 116, 139, 0.5); color: #cbd5e1; margin-left: 0.5rem;">
                                <i class="bi bi-eye me-1"></i>Chế độ xem
                            </span>
                        }
                    </span>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Nhân viên</th>
                                <th>Mã NV</th>
                                <th>Email</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acc in filteredAccounts)
                            {
                                <tr>
                                    <td style="color: #60a5fa; font-weight: 500;">@acc.Username</td>
                                    <td style="color: #e2e8f0;">@acc.FullName</td>
                                    <td style="color: #94a3b8; font-family: monospace;">@acc.EmployeeCode</td>
                                    <td style="color: #94a3b8; font-size: 0.9rem;">@acc.EmailCompany</td>
                                    <td>
                                        @foreach (var role in acc.RoleNames)
                                        {
                                            <span class="badge bg-purple me-1">@role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (acc.Status)
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Khóa</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (currentUserAccount != null && AuthorizationHelper.CanEditAccount(currentUserAccount, acc))
                                        {
                                            <button class="btn btn-sm btn-info me-1" @onclick="() => ShowEditModal(acc.Id)" title="Sửa">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                        @if (currentUserAccount != null && AuthorizationHelper.CanResetPassword(currentUserAccount, acc))
                                        {
                                            <button class="btn btn-sm btn-warning me-1" @onclick="() => ShowResetPasswordConfirmation(acc.Id)" title="Reset mật khẩu">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        }
                                        @if (currentUserAccount != null && AuthorizationHelper.CanDeleteAccount(currentUserAccount, acc))
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirmation(acc.Id)" title="Xóa">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                        @if (currentUserAccount == null || 
                                            (!AuthorizationHelper.CanEditAccount(currentUserAccount, acc) && 
                                             !AuthorizationHelper.CanResetPassword(currentUserAccount, acc) && 
                                             !AuthorizationHelper.CanDeleteAccount(currentUserAccount, acc)))
                                        {
                                            <span class="text-muted" style="font-size: 0.85rem;">
                                                <i class="bi bi-eye-slash me-1"></i>Chỉ xem
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-@alertClass mt-3">
                <i class="bi bi-@(alertClass == "success" ? "check-circle" : "exclamation-triangle") me-2"></i>
                @message
            </div>
        }
    }
</div>

<!-- Create Account Modal -->
<CreateAccountModal IsOpen="@isCreateModalOpen" OnClose="@CloseCreateModal"
                    OnSave="@HandleCreateAccount" Employees="@employeeList" Roles="@roleList" />

<!-- Edit Account Modal -->
<EditAccountModal IsOpen="@isEditModalOpen" OnClose="@CloseEditModal"
                  OnSave="@HandleUpdateAccount" AccountData="@selectedAccount" Roles="@roleList" />

<!-- Reset Password Confirmation Modal -->
@if (showResetPasswordModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: #1e293b; color: #e2e8f0;">
                <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-clockwise me-2 text-warning"></i>Xác nhận Reset Mật khẩu
                    </h5>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc chắn muốn reset mật khẩu tài khoản này?</p>
                    <p class="text-warning mb-0">Mật khẩu sẽ được reset về: <strong>Password123</strong></p>
                </div>
                <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,0.1);">
                    <button type="button" class="btn btn-secondary" @onclick="CloseResetPasswordModal">Hủy</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmResetPassword">Reset</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: #1e293b; color: #e2e8f0;">
                <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Xác nhận xóa
                    </h5>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc chắn muốn xóa tài khoản này?</p>
                    <p class="text-danger mb-0">Hành động này không thể hoàn tác!</p>
                </div>
                <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,0.1);">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Hủy</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Xóa</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountDto>? accounts;
    private List<AccountDto>? allAccounts; // Store all accounts before filtering
    private List<EmployeeDto> employeeList = new();
    private List<RoleDto> roleList = new();
    private List<RoleDto> roles = new();
    
    private string message = string.Empty;
    private string alertClass = "success";
    
    // Modal states
    private bool isCreateModalOpen = false;
    private bool isEditModalOpen = false;
    private bool showResetPasswordModal = false;
    private bool showDeleteModal = false;
    
    // Selected items
    private UpdateAccountDto? selectedAccount = null;
    private int resetPasswordAccountId = 0;
    private int deleteAccountId = 0;

    // Current user
    private int currentAccountId = 0;
    private string currentUserRole = string.Empty;
    private bool isAdmin = false;
    private AccountDto? currentUserAccount = null;

    // Filter variables
    private string searchKeyword = string.Empty;
    private string filterRoleId = string.Empty;
    private string filterStatus = string.Empty;

    // Computed property for filtered accounts
    private IEnumerable<AccountDto> filteredAccounts
    {
        get
        {
            if (accounts == null)
                return Enumerable.Empty<AccountDto>();

            var result = accounts.AsEnumerable();

            // Search keyword filter
            if (!string.IsNullOrWhiteSpace(searchKeyword))
            {
                var keyword = searchKeyword.Trim().ToLower();
                result = result.Where(a =>
                    (a.Username?.ToLower().Contains(keyword) ?? false) ||
                    (a.FullName?.ToLower().Contains(keyword) ?? false) ||
                    (a.EmailCompany?.ToLower().Contains(keyword) ?? false) ||
                    (a.EmployeeCode?.ToLower().Contains(keyword) ?? false)
                );
            }

            // Role filter
            if (!string.IsNullOrWhiteSpace(filterRoleId))
            {
                if (int.TryParse(filterRoleId, out int roleId))
                {
                    result = result.Where(a => a.RoleIds.Contains(roleId));
                }
            }

            // Status filter
            if (!string.IsNullOrWhiteSpace(filterStatus))
            {
                if (bool.TryParse(filterStatus, out bool status))
                {
                    result = result.Where(a => a.Status == status);
                }
            }

            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadData();
    }
    
    private async Task LoadCurrentUser()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            if (user.Identity?.IsAuthenticated == true)
            {
                // Get AccountId
                var accountIdClaim = user.Claims.FirstOrDefault(c => c.Type == "AccountId");
                if (accountIdClaim != null && int.TryParse(accountIdClaim.Value, out int accId))
                {
                    currentAccountId = accId;
                    
                    // Special handling for hardcoded admin account (Id = -1)
                    if (accId == -1)
                    {
                        // Create fake AccountDto for admin
                        var fullNameClaim = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Name);
                        currentUserAccount = new AccountDto
                        {
                            Id = -1,
                            Username = "admin",
                            Status = true,
                            UserId = -1,
                            EmployeeCode = "ADMIN",
                            FullName = fullNameClaim?.Value ?? "System Administrator",
                            EmailCompany = "admin@system.local",
                            DepartmentId = -1,
                            RoleIds = new List<int>(),
                            RoleNames = new List<string> { "Admin" }
                        };
                    }
                    else
                    {
                        // Load current user's account details from database
                        currentUserAccount = await AccountService.GetByIdAsync(accId);
                    }
                }
                
                // Get Role
                var roleClaim = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role);
                if (roleClaim != null)
                {
                    currentUserRole = roleClaim.Value;
                    isAdmin = (currentUserRole == "Admin");
                }
            }
        }
        catch
        {
            currentAccountId = 0;
            currentUserRole = string.Empty;
            isAdmin = false;
            currentUserAccount = null;
        }
    }

    private async Task LoadData()
    {
        try
        {
            allAccounts = await AccountService.GetAllAsync();
            
            // Filter accounts based on user permission
            if (currentUserAccount != null)
            {
                accounts = AuthorizationHelper.FilterAccountsByPermission(currentUserAccount, allAccounts);
            }
            else
            {
                accounts = allAccounts;
            }
            
            employeeList = await EmployeeService.GetEmployeesWithDetailsAsync();
            roleList = await RoleService.GetAllAsync();
            roles = roleList; // Populate roles for dropdown
        }
        catch (Exception ex)
        {
            message = $"Lỗi tải dữ liệu: {ex.Message}";
            alertClass = "danger";
        }
    }

    private void ClearFilters()
    {
        searchKeyword = string.Empty;
        filterRoleId = string.Empty;
        filterStatus = string.Empty;
    }

    // Create
    private void ShowCreateModal()
    {
        isCreateModalOpen = true;
        message = string.Empty;
    }

    private void CloseCreateModal()
    {
        isCreateModalOpen = false;
    }

    private async Task HandleCreateAccount(CreateAccountDto dto)
    {
        try
        {
            var created = await AccountService.CreateAsync(dto);
            message = $"Đã tạo tài khoản '{created.Username}' thành công!";
            alertClass = "success";
            isCreateModalOpen = false;
            await LoadData();
        }
        catch (BusinessException ex)
        {
            message = $"Lỗi: {ex.Message}";
            alertClass = "danger";
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "danger";
        }
    }

    // Edit
    private void ShowEditModal(int accountId)
    {
        var account = accounts?.FirstOrDefault(a => a.Id == accountId);
        if (account != null)
        {
            selectedAccount = new UpdateAccountDto
            {
                Id = account.Id,
                Username = account.Username,
                Status = account.Status,
                RoleIds = new List<int>(account.RoleIds)
            };
            isEditModalOpen = true;
            message = string.Empty;
        }
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        selectedAccount = null;
    }

    private async Task HandleUpdateAccount(UpdateAccountDto dto)
    {
        try
        {
            bool success = await AccountService.UpdateAsync(dto);
            if (success)
            {
                message = $"Đã cập nhật tài khoản '{dto.Username}' thành công!";
                alertClass = "success";
                isEditModalOpen = false;
                await LoadData();
            }
            else
            {
                message = "Không tìm thấy tài khoản để cập nhật.";
                alertClass = "danger";
            }
        }
        catch (BusinessException ex)
        {
            message = $"Lỗi: {ex.Message}";
            alertClass = "danger";
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "danger";
        }
    }

    // Reset Password
    private void ShowResetPasswordConfirmation(int accountId)
    {
        resetPasswordAccountId = accountId;
        showResetPasswordModal = true;
    }

    private void CloseResetPasswordModal()
    {
        showResetPasswordModal = false;
        resetPasswordAccountId = 0;
    }

    private async Task ConfirmResetPassword()
    {
        try
        {
            bool success = await AccountService.ResetPasswordAsync(resetPasswordAccountId);
            if (success)
            {
                message = "Đã reset mật khẩu về 'Password123' thành công!";
                alertClass = "success";
                showResetPasswordModal = false;
            }
            else
            {
                message = "Không tìm thấy tài khoản.";
                alertClass = "danger";
            }
        }
        catch (Exception ex)
        {
            message = $"Lỗi: {ex.Message}";
            alertClass = "danger";
        }
    }

    // Delete
    private void ShowDeleteConfirmation(int accountId)
    {
        deleteAccountId = accountId;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deleteAccountId = 0;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            bool success = await AccountService.DeleteAsync(deleteAccountId);
            if (success)
            {
                message = "Đã xóa tài khoản thành công!";
                alertClass = "success";
                showDeleteModal = false;
                await LoadData();
            }
            else
            {
                message = "Không tìm thấy tài khoản để xóa.";
                alertClass = "danger";
            }
        }
        catch (Exception ex)
        {
            message = $"Lỗi: {ex.Message}";
            alertClass = "danger";
        }
    }
}
