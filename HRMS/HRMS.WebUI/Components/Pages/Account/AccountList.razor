@page "/accounts"
@rendermode InteractiveServer
@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs
@using HRMS.Domain.Exceptions
@using HRMS.WebUI.Components.Pages.Account
@inject IAccountService AccountService
@inject IEmployeeService EmployeeService
@inject IRoleService RoleService
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,HRM,HR")]

<PageTitle>Quản lý Tài khoản</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="page-title">
                <i class="bi bi-person-badge-fill me-2"></i>Quản lý Tài khoản
            </h2>
            <p class="page-subtitle">Quản lý thông tin đăng nhập và phân quyền người dùng</p>
        </div>
    </div>

    @if (accounts == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-3 text-muted-light">Đang tải dữ liệu...</p>
        </div>
    }
    else if (!accounts.Any())
    {
        <div class="alert alert-info-dark">
            <i class="bi bi-info-circle me-2"></i>Chưa có tài khoản nào trong hệ thống.
        </div>
    }
    else
    {
        <!-- Table Toolbar -->
        <div class="table-toolbar mb-3">
            <div class="toolbar-left">
                <div class="search-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text"
                           class="form-control search-input"
                           placeholder="Tìm kiếm tài khoản (Username, Tên, Mã NV)"
                           @bind="searchKeyword"
                           @bind:event="oninput"
                           @onkeyup="ApplyFilters" />
                
                    @if (!string.IsNullOrEmpty(searchKeyword))
                    {
                        <button class="btn-clear-search" @onclick="ClearSearch">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
            </div>

            <div class="toolbar-right">
                <button class="btn-add-new" @onclick="AddNewAccount">
                    <i class="bi bi-plus-circle me-2"></i>Thêm tài khoản mới
                </button>
            </div>
        </div>

        <div class="card-dark">
            <div class="table-responsive">
                <table class="table-dark-custom">
                    <thead>
                        <tr>
                            <th style="width: 180px">Username</th>
                            <th style="width: 240px">Nhân viên</th>
                            <th style="width: 120px">Mã NV</th>
                            <th style="width: 220px">Email</th>
                            <th style="width: 180px">Vai trò</th>
                            <th style="width: 120px" class="text-center">Trạng thái</th>
                            <th style="width: 140px" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var acc in GetPaginatedAccounts())
                        {
                            <tr>
                                <td><span class="username-text">@acc.Username</span></td>
                                <td><span class="employee-name-text">@acc.FullName</span></td>
                                <td><span class="employee-code-text">@acc.EmployeeCode</span></td>
                                <td><span class="email-text">@acc.EmailCompany</span></td>
                                <td>
                                    @foreach (var role in acc.RoleNames)
                                    {
                                        <span class="badge-dark badge-role me-1">
                                            <i class="bi bi-shield-fill-check me-1"></i>@role
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (acc.Status)
                                    {
                                        <span class="badge-dark badge-active">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-dark badge-inactive">
                                            <i class="bi bi-dash-circle-fill me-1"></i>Khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-icons">
                                        <button class="icon-btn icon-edit"
                                                @onclick="() => EditAccount(acc.Id)"
                                                title="Chỉnh sửa">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="icon-btn icon-key"
                                                @onclick="() => ChangePassword(acc.Id)"
                                                title="Đổi mật khẩu">
                                            <i class="bi bi-key-fill"></i>
                                        </button>
                                        <button class="icon-btn icon-delete"
                                                @onclick="() => DeleteAccount(acc.Id)"
                                                title="Xóa">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (GetTotalCount() > 0)
        {
            <div class="pagination-wrapper">
                <div class="pagination-left">
                    <span class="pagination-text">
                        Hiển thị @GetStartIndex() đến @GetEndIndex() trên tổng số @GetTotalCount() tài khoản
                    </span>
                </div>
                <div class="pagination-controls">
                    <button class="pagination-btn" @onclick="FirstPage" disabled="@(currentPage == 1)">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                    <button class="pagination-btn" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="pagination-text">Trang @currentPage / @totalPages</span>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(currentPage == totalPages)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="pagination-btn" @onclick="LastPage" disabled="@(currentPage == totalPages)">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @alertClass mt-3">
                <i class="bi @(alertClass == "alert-success-dark" ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                @message
            </div>
        }
    }
</div>

<!-- Create Account Modal -->
<CreateAccountModal
    IsOpen="@isCreateModalOpen"
    OnClose="@CloseCreateModal"
    OnSave="@HandleCreateAccount"
    Employees="@employeeList"
    Roles="@roleList" />

<!-- Edit Account Modal -->
<EditAccountModal
    IsOpen="@isEditModalOpen"
    OnClose="@CloseEditModal"
    OnSave="@HandleUpdateAccount"
    AccountData="@selectedAccount"
    Roles="@roleList" />

<!-- Change Password Modal -->
<ChangePasswordModal
    IsOpen="@isChangePasswordModalOpen"
    OnClose="@CloseChangePasswordModal"
    OnSave="@HandleChangePassword"
    AccountId="@selectedAccountId" />

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content-dark">
                <div class="modal-header-dark bg-danger">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <p>Bạn có chắc chắn muốn xóa tài khoản này?</p>
                    <p class="text-danger mb-0">Hành động này không thể hoàn tác!</p>
                </div>
                <div class="modal-footer-dark">
                    <button type="button" class="btn btn-secondary-dark" @onclick="CloseDeleteModal">Hủy</button>
                    <button type="button" class="btn btn-danger-dark" @onclick="ConfirmDelete">Xóa</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Business Error Modal -->
@if (showBusinessErrorModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content-dark">
                <div class="modal-header-dark bg-danger">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Lỗi
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <p class="mb-0">@businessErrorMessage</p>
                </div>
                <div class="modal-footer-dark">
                    <button type="button" class="btn btn-secondary-dark" @onclick="CloseBusinessErrorModal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountDto>? accounts;
    private string searchKeyword = string.Empty;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)GetFilteredAccounts().Count() / pageSize);

    private string message = string.Empty;
    private string alertClass = string.Empty;
    private bool showBusinessErrorModal = false;
    private string businessErrorMessage = string.Empty;
    private bool showDeleteModal = false;
    private int deleteAccountId = 0;

    // Modal states
    private bool isCreateModalOpen = false;
    private bool isEditModalOpen = false;
    private bool isChangePasswordModalOpen = false;
    private UpdateAccountDto? selectedAccount = null;
    private int selectedAccountId = 0;

    // Dropdown data
    private List<EmployeeDto> employeeList = new();
    private List<RoleDto> roleList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await LoadDropdownData();
    }

    private async Task LoadAccounts()
    {
        accounts = await AccountService.GetAllAsync();
    }

    private async Task LoadDropdownData()
    {
        employeeList = await EmployeeService.GetEmployeesWithDetailsAsync();
        roleList = await RoleService.GetAllAsync();
    }

    private IEnumerable<AccountDto> GetFilteredAccounts()
    {
        if (accounts == null) return Enumerable.Empty<AccountDto>();

        var filtered = accounts.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            var keyword = searchKeyword.ToLower();
            filtered = filtered.Where(a =>
                a.Username.ToLower().Contains(keyword) ||
                a.FullName.ToLower().Contains(keyword) ||
                a.EmployeeCode.ToLower().Contains(keyword)
            );
        }

        return filtered;
    }

    private IEnumerable<AccountDto> GetPaginatedAccounts()
    {
        var filtered = GetFilteredAccounts();
        return filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);
    }

    private int GetStartIndex()
    {
        var total = GetFilteredAccounts().Count();
        if (total == 0) return 0;
        return (currentPage - 1) * pageSize + 1;
    }

    private int GetEndIndex()
    {
        var total = GetFilteredAccounts().Count();
        var end = currentPage * pageSize;
        return Math.Min(end, total);
    }

    private int GetTotalCount()
    {
        return GetFilteredAccounts().Count();
    }

    private void FirstPage() => currentPage = 1;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }
    private void LastPage() => currentPage = totalPages;

    private void ApplyFilters()
    {
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchKeyword = string.Empty;
        currentPage = 1;
        StateHasChanged();
    }

    private void AddNewAccount()
    {
        isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        isCreateModalOpen = false;
        message = string.Empty;
    }

    private async Task HandleCreateAccount(CreateAccountDto newAccount)
    {
        try
        {
            var createdAccount = await AccountService.CreateAsync(newAccount);
            message = $"Đã tạo tài khoản {createdAccount.Username} thành công.";
            alertClass = "alert-success-dark";
            isCreateModalOpen = false;
            await LoadAccounts();
            currentPage = 1;
        }
        catch (BusinessException ex)
        {
            businessErrorMessage = ex.Message;
            showBusinessErrorModal = true;
            isCreateModalOpen = false;
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "alert-danger-dark";
            isCreateModalOpen = false;
        }
    }

    private void EditAccount(int accountId)
    {
        var account = accounts?.FirstOrDefault(a => a.Id == accountId);
        if (account != null)
        {
            selectedAccount = new UpdateAccountDto
            {
                Id = account.Id,
                Username = account.Username,
                Status = account.Status,
                RoleIds = account.RoleIds
            };
            isEditModalOpen = true;
            message = string.Empty;
        }
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        selectedAccount = null;
        message = string.Empty;
    }

    private async Task HandleUpdateAccount(UpdateAccountDto updatedAccount)
    {
        try
        {
            bool success = await AccountService.UpdateAsync(updatedAccount);
            if (!success)
            {
                message = "Không tìm thấy tài khoản để cập nhật.";
                alertClass = "alert-danger-dark";
            }
            else
            {
                message = $"Đã cập nhật tài khoản {updatedAccount.Username} thành công.";
                alertClass = "alert-success-dark";
                await LoadAccounts();
            }
            isEditModalOpen = false;
            selectedAccount = null;
        }
        catch (BusinessException ex)
        {
            businessErrorMessage = ex.Message;
            showBusinessErrorModal = true;
            isEditModalOpen = false;
            selectedAccount = null;
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "alert-danger-dark";
            isEditModalOpen = false;
            selectedAccount = null;
        }
    }

    private void ChangePassword(int accountId)
    {
        selectedAccountId = accountId;
        isChangePasswordModalOpen = true;
    }

    private void CloseChangePasswordModal()
    {
        isChangePasswordModalOpen = false;
        selectedAccountId = 0;
        message = string.Empty;
    }

    private async Task HandleChangePassword(ChangePasswordDto dto)
    {
        try
        {
            bool success = await AccountService.ChangePasswordAsync(dto);
            if (success)
            {
                message = "Đã đổi mật khẩu thành công.";
                alertClass = "alert-success-dark";
            }
            else
            {
                message = "Không tìm thấy tài khoản.";
                alertClass = "alert-danger-dark";
            }
            isChangePasswordModalOpen = false;
            selectedAccountId = 0;
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "alert-danger-dark";
            isChangePasswordModalOpen = false;
            selectedAccountId = 0;
        }
    }

    private void DeleteAccount(int accountId)
    {
        deleteAccountId = accountId;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deleteAccountId = 0;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            bool success = await AccountService.DeleteAsync(deleteAccountId);
            if (success)
            {
                message = "Đã xóa tài khoản thành công.";
                alertClass = "alert-success-dark";
                await LoadAccounts();
            }
            else
            {
                message = "Không tìm thấy tài khoản để xóa.";
                alertClass = "alert-danger-dark";
            }
            showDeleteModal = false;
            deleteAccountId = 0;
        }
        catch (Exception ex)
        {
            message = $"Lỗi hệ thống: {ex.Message}";
            alertClass = "alert-danger-dark";
            showDeleteModal = false;
            deleteAccountId = 0;
        }
    }

    private void CloseBusinessErrorModal()
    {
        showBusinessErrorModal = false;
        businessErrorMessage = string.Empty;
    }
}

