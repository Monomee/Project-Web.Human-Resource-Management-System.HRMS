@page "/accounts"
@rendermode InteractiveServer
@inject IAccountService AccountService
@inject IEmployeeService EmployeeService  
@inject IRoleService RoleService
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,HRM,HR")]

<PageTitle>Quản lý Tài khoản</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 style="color: #f1f5f9; font-size: 1.75rem; font-weight: 600;">
                <i class="bi bi-person-badge-fill me-2"></i>Quản lý Tài khoản
            </h2>
            <p style="color: #94a3b8; font-size: 0.95rem;">Quản lý thông tin đăng nhập và phân quyền người dùng</p>
        </div>
    </div>

    @if (accounts == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3" style="color: #94a3b8;">Đang tải dữ liệu...</p>
        </div>
    }
    else
    {
        <div class="card" style="background: rgba(20, 23, 38, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px;">
            <div class="card-body">
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="ShowCreateModal">
                        <i class="bi bi-plus-circle me-2"></i>Thêm tài khoản mới
                    </button>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Nhân viên</th>
                                <th>Mã NV</th>
                                <th>Email</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acc in accounts)
                            {
                                <tr>
                                    <td style="color: #60a5fa; font-weight: 500;">@acc.Username</td>
                                    <td style="color: #e2e8f0;">@acc.FullName</td>
                                    <td style="color: #94a3b8; font-family: monospace;">@acc.EmployeeCode</td>
                                    <td style="color: #94a3b8; font-size: 0.9rem;">@acc.EmailCompany</td>
                                    <td>
                                        @foreach (var role in acc.RoleNames)
                                        {
                                            <span class="badge bg-purple me-1">@role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (acc.Status)
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Khóa</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-info me-1" @onclick="() => EditAccount(acc.Id)" title="Sửa">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => ChangePassword(acc.Id)" title="Đổi MK">
                                            <i class="bi bi-key-fill"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAccount(acc.Id)" title="Xóa">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-@alertClass mt-3">@message</div>
        }
    }
</div>

@code {
    private List<AccountDto>? accounts;
    private string message = string.Empty;
    private string alertClass = "success";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = await AccountService.GetAllAsync();
        }
        catch (Exception ex)
        {
            message = $"Lỗi: {ex.Message}";
            alertClass = "danger";
        }
    }

    private void ShowCreateModal()
    {
        message = "Chức năng đang phát triển - Tạo tài khoản mới";
        alertClass = "info";
    }

    private void EditAccount(int id)
    {
        message = $"Chức năng đang phát triển - Sửa tài khoản ID: {id}";
        alertClass = "info";
    }

    private void ChangePassword(int id)
    {
        message = $"Chức năng đang phát triển - Đổi mật khẩu tài khoản ID: {id}";
        alertClass = "info";
    }

    private void DeleteAccount(int id)
    {
        message = $"Chức năng đang phát triển - Xóa tài khoản ID: {id}";
        alertClass = "info";
    }
}
