@using HRMS.Application.DTOs

@if (IsOpen)
{
    <div class="modal fade show d-block modal-backdrop-click" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content-dark">
                <div class="modal-header-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-key-fill me-2"></i>Đổi mật khẩu
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label-dark">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" class="form-control-dark" @bind="model.NewPassword" placeholder="Nhập mật khẩu mới" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-dark">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" class="form-control-dark" @bind="confirmPassword" placeholder="Nhập lại mật khẩu mới" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger-dark">
                                <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                            </div>
                        }

                        <div class="modal-footer-dark mt-4">
                            <button type="button" class="btn btn-secondary-dark" @onclick="Close">
                                <i class="bi bi-x-circle me-1"></i>Đóng
                            </button>
                            <button type="submit" class="btn btn-primary-dark">
                                <i class="bi bi-check-circle me-1"></i>Đổi mật khẩu
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AdminChangePasswordDto> OnSave { get; set; }
    [Parameter] public int AccountId { get; set; }

    private AdminChangePasswordDto model = new();
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            model = new AdminChangePasswordDto { AccountId = AccountId };
            confirmPassword = string.Empty;
            errorMessage = string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(model.NewPassword))
        {
            errorMessage = "Vui lòng nhập mật khẩu mới.";
            return;
        }

        if (model.NewPassword.Length < 6)
        {
            errorMessage = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }

        if (model.NewPassword != confirmPassword)
        {
            errorMessage = "Mật khẩu xác nhận không khớp.";
            return;
        }

        await OnSave.InvokeAsync(model);
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}

<style>
    .modal-backdrop-click {
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 1050;
    }

    .modal-dialog {
        pointer-events: auto;
        z-index: 1051;
    }

    .modal-content-dark {
        background: #1e293b;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e2e8f0;
        pointer-events: auto;
    }

    .modal-header-dark {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.15) 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.25rem 1.5rem;
    }

    .modal-title {
        color: #f1f5f9;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .modal-body-dark {
        padding: 1.5rem;
    }

    .form-label-dark {
        color: #cbd5e1;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .form-control-dark {
        background: rgba(30, 41, 59, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #e2e8f0 !important;
        padding: 0.6rem 1rem;
        width: 100%;
    }

    .form-control-dark:focus {
        background: rgba(30, 41, 59, 0.8) !important;
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.15);
    }

    .alert-danger-dark {
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #ef4444;
        padding: 0.75rem;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .modal-footer-dark {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .btn-secondary-dark {
        background: rgba(71, 85, 105, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e2e8f0;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-primary-dark {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        color: white;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        cursor: pointer;
    }

    .text-danger {
        color: #ef4444;
    }
</style>
