@using HRMS.Application.DTOs

@if (IsOpen)
{
    <div class="modal fade show d-block modal-backdrop-click" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content-dark">
                <div class="modal-header-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus-fill me-2"></i>Tạo tài khoản mới
                    </h5>
                </div>
                <div class="modal-body-dark">
                    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <!-- Employee Selection -->
                            <div class="col-md-6">
                                <label class="form-label-dark">Nhân viên <span class="text-danger">*</span></label>
                                <select class="form-control-dark" @bind="model.UserId">
                                    <option value="0">-- Chọn nhân viên --</option>
                                    @foreach (var emp in Employees.Where(e => !HasAccount(e.Id)))
                                    {
                                        <option value="@emp.Id">@emp.FullName (@emp.EmployeeCode)</option>
                                    }
                                </select>
                            </div>

                            <!-- Username -->
                            <div class="col-md-6">
                                <label class="form-label-dark">Username <span class="text-danger">*</span></label>
                                <input type="text" class="form-control-dark" @bind="model.Username" placeholder="username" />
                            </div>

                            <!-- Password -->
                            <div class="col-md-6">
                                <label class="form-label-dark">Mật khẩu <span class="text-danger">*</span></label>
                                <input type="password" class="form-control-dark" @bind="model.Password" placeholder="Nhập mật khẩu" />
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <label class="form-label-dark">Trạng thái</label>
                                <select class="form-control-dark" @bind="model.Status">
                                    <option value="true">Hoạt động</option>
                                    <option value="false">Khóa</option>
                                </select>
                            </div>

                            <!-- Roles Selection -->
                            <div class="col-12">
                                <label class="form-label-dark">Vai trò <span class="text-danger">*</span></label>
                                <div class="roles-checkbox-group">
                                    @foreach (var role in Roles)
                                    {
                                        <div class="form-check-dark">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="role-@role.Id" 
                                                   @onchange="e => ToggleRole(role.Id, e)" />
                                            <label class="form-check-label" for="role-@role.Id">
                                                @role.Name
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer-dark mt-4">
                            <button type="button" class="btn btn-secondary-dark" @onclick="Close">
                                <i class="bi bi-x-circle me-1"></i>Đóng
                            </button>
                            <button type="submit" class="btn btn-primary-dark">
                                <i class="bi bi-check-circle me-1"></i>Tạo tài khoản
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CreateAccountDto> OnSave { get; set; }
    [Parameter] public List<EmployeeDto> Employees { get; set; } = new();
    [Parameter] public List<RoleDto> Roles { get; set; } = new();

    private CreateAccountDto model = new();

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            model = new CreateAccountDto { Status = true, RoleIds = new List<int>() };
        }
    }

    private bool HasAccount(int userId)
    {
        // This is a simplified check - in production, you'd query the service
        return false;
    }

    private void ToggleRole(int roleId, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            if (!model.RoleIds.Contains(roleId))
                model.RoleIds.Add(roleId);
        }
        else
        {
            model.RoleIds.Remove(roleId);
        }
    }

    private async Task HandleSubmit()
    {
        if (model.UserId == 0 || string.IsNullOrWhiteSpace(model.Username) || 
            string.IsNullOrWhiteSpace(model.Password) || !model.RoleIds.Any())
        {
            return;
        }

        await OnSave.InvokeAsync(model);
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}

