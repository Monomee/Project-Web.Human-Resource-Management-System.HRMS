@page "/attendance/my-attendance"
@rendermode InteractiveServer

@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs.Attendance
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IAttendanceService AttendanceService
@inject IAccountService AccountService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Điểm danh cá nhân — HRMS</PageTitle>

<div class="container-fluid mt-4">
    @* ── HEADER ── *@
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="page-title">
                <i class="bi bi-clock-history me-2 text-primary"></i>Điểm danh Cá nhân
            </h2>
            <p class="page-subtitle">Thực hiện Check In / Check Out và theo dõi lịch sử điểm danh hàng ngày</p>
        </div>
        <div class="col-auto">
            <span class="badge-dark badge-department fs-6 px-3 py-2">
                <i class="bi bi-calendar3 me-2 text-info"></i>
                Hôm nay: <strong class="text-white">@(_todayDate.ToString("dd/MM/yyyy"))</strong>
            </span>
        </div>
    </div>

    @* ── ALERTS ── *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger-dark mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success-dark mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
            <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @* ── CARD THÔNG TIN ĐIỂM DANH HÔM NAY ── *@
    <div class="card-dark-form p-4 mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-md-5">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge-dark badge-department text-primary fs-6">
                        <i class="bi bi-person-workspace me-1"></i>@(_todayAttendance?.ShiftName ?? "Ca Hành Chính Standard")
                    </span>
                    <span class="badge-dark @GetStatusBadgeClass(_todayAttendance?.Status ?? "")">
                        @(_todayAttendance?.Status ?? "Chưa có dữ liệu")
                    </span>
                </div>
                <div class="text-muted-light small mt-2">
                    <i class="bi bi-info-circle me-1 text-info"></i>Vào/Ra chuẩn: 08:00 - 17:30 (Nghỉ trưa: 12:00 - 13:30)
                </div>
            </div>

            <div class="col-md-7">
                <div class="row g-3 text-center">
                    <div class="col-6 col-sm-3">
                        <div class="p-3 rounded-3" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.08);">
                            <div class="small text-muted-light mb-1">Check-In</div>
                            <div class="fw-bold fs-5 text-success font-monospace">
                                @(_todayAttendance?.CheckInTime?.ToString("HH:mm:ss") ?? "--:--:--")
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="p-3 rounded-3" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.08);">
                            <div class="small text-muted-light mb-1">Check-Out</div>
                            <div class="fw-bold fs-5 text-info font-monospace">
                                @(_todayAttendance?.CheckOutTime?.ToString("HH:mm:ss") ?? "--:--:--")
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 d-flex align-items-center justify-content-end gap-2">
                        <button class="btn-checkin w-100"
                                disabled="@(_todayAttendance?.CheckInTime != null || _isProcessing)"
                                @onclick="HandleCheckIn">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Check In
                        </button>
                        <button class="btn-checkout w-100"
                                disabled="@(_todayAttendance?.CheckInTime == null || _todayAttendance?.CheckOutTime != null || _isProcessing)"
                                @onclick="HandleCheckOut">
                            <i class="bi bi-box-arrow-left me-1"></i> Check Out
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── BẢNG LỊCH SỬ CHẤM CÔNG CÁ NHÂN ── *@
    <div class="table-toolbar mb-0">
        <div class="toolbar-left">
            <h5 class="mb-0 fw-bold text-white fs-6">
                <i class="bi bi-table me-2 text-primary"></i>Lịch sử Chấm công cá nhân
            </h5>
        </div>
        <div class="toolbar-right">
            <button class="btn-refresh" @onclick="LoadDataAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </button>
        </div>
    </div>

    <div class="card-dark mb-4">
        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted-light">Đang tải lịch sử chấm công...</p>
            </div>
        }
        else if (!_history.Any())
        {
            <div class="text-center py-5 text-muted-light">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                Chưa có lịch sử chấm công nào.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-dark-custom">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Ca làm việc</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th class="text-center">Số phút làm</th>
                            <th class="text-center">Trễ (phút)</th>
                            <th class="text-center">Sớm (phút)</th>
                            <th class="text-center">OT (phút)</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _history)
                        {
                            <tr>
                                <td class="fw-semibold font-monospace text-info">@item.AttendanceDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge-dark badge-department">@item.ShiftName</span></td>
                                <td><span class="text-success font-monospace fw-bold">@(item.CheckInTime?.ToString("HH:mm:ss") ?? "--:--:--")</span></td>
                                <td><span class="text-info font-monospace fw-bold">@(item.CheckOutTime?.ToString("HH:mm:ss") ?? "--:--:--")</span></td>
                                <td class="text-center fw-semibold">@item.WorkingMinutes m</td>
                                <td class="text-center">
                                    @if (item.LateMinutes > 0)
                                    {
                                        <span class="badge-dark badge-inactive">@item.LateMinutes m</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted-light">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.EarlyLeaveMinutes > 0)
                                    {
                                        <span class="badge-dark text-warning border-warning">@item.EarlyLeaveMinutes m</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted-light">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.OvertimeMinutes > 0)
                                    {
                                        <span class="badge-dark badge-active">@item.OvertimeMinutes m</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted-light">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge-dark @GetStatusBadgeClass(item.Status)">@item.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .page-title { color: #f1f5f9; font-size: 1.75rem; font-weight: 600; margin-bottom: 0.5rem; }
    .page-subtitle { color: #94a3b8; font-size: 0.95rem; margin-bottom: 0; }
    .text-muted-light { color: #94a3b8 !important; }

    .card-dark-form {
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        backdrop-filter: blur(12px);
    }

    .btn-checkin {
        height: 48px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        border: none; border-radius: 8px; color: white;
        font-weight: 600; font-size: 0.95rem; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.2s ease; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.2);
    }
    .btn-checkin:hover:not(:disabled) {
        background: linear-gradient(135deg, #16a34a, #15803d); transform: translateY(-2px);
    }
    .btn-checkin:disabled { opacity: 0.4; cursor: not-allowed; }

    .btn-checkout {
        height: 48px;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        border: none; border-radius: 8px; color: white;
        font-weight: 600; font-size: 0.95rem; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.2s ease; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
    }
    .btn-checkout:hover:not(:disabled) {
        background: linear-gradient(135deg, #2563eb, #1d4ed8); transform: translateY(-2px);
    }
    .btn-checkout:disabled { opacity: 0.4; cursor: not-allowed; }

    .table-toolbar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1.25rem 1.5rem; background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px 12px 0 0;
        backdrop-filter: blur(12px);
    }

    .btn-refresh {
        height: 36px; padding: 0 1rem;
        background: rgba(51, 65, 85, 0.5); border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px; color: #cbd5e1; font-size: 0.85rem; font-weight: 500;
        cursor: pointer; transition: all 0.2s ease;
    }
    .btn-refresh:hover { background: rgba(51, 65, 85, 0.8); color: white; }

    .card-dark {
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0 0 12px 12px; border-top: none;
        backdrop-filter: blur(12px); padding: 0; overflow: hidden;
    }

    .table-dark-custom { width: 100%; margin-bottom: 0; color: #e2e8f0; border-collapse: separate; border-spacing: 0; }
    .table-dark-custom thead { background: rgba(30, 41, 59, 0.8); }
    .table-dark-custom thead th { padding: 1rem 1.25rem; font-weight: 600; font-size: 0.875rem; text-transform: uppercase; color: #cbd5e1; border: none; }
    .table-dark-custom tbody tr { border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: background-color 0.2s ease; }
    .table-dark-custom tbody tr:hover { background: rgba(51, 65, 85, 0.4); }
    .table-dark-custom tbody td { padding: 0.9rem 1.25rem; vertical-align: middle; border: none; }

    .badge-dark { padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.8125rem; font-weight: 500; display: inline-flex; align-items: center; }
    .badge-department { background: rgba(51, 65, 85, 0.5); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.05); }
    .badge-active { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
    .badge-inactive { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    .alert-danger-dark { background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 0.75rem 1.25rem; }
    .alert-success-dark { background: rgba(34, 197, 94, 0.15); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 8px; padding: 0.75rem 1.25rem; }
</style>

@code {
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private string? _errorMessage;
    private string? _successMessage;

    private int _currentUserId = 0;
    private DateOnly _todayDate = DateOnly.FromDateTime(DateTime.Now);
    private AttendanceDetailDto? _todayAttendance;
    private List<AttendanceDetailDto> _history = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadDataAsync();
    }

    private async Task LoadCurrentUserAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                               ?? user.FindFirst("sub")?.Value;
                if (int.TryParse(userIdClaim, out int uid))
                {
                    _currentUserId = uid;
                }
                else
                {
                    var accounts = await AccountService.GetAllAsync();
                    var userEntity = accounts.FirstOrDefault(a => a.Username == user.Identity.Name);
                    if (userEntity != null) _currentUserId = userEntity.UserId;
                }
            }
        }
        catch
        {
            _currentUserId = 0;
        }
    }

    private async Task LoadDataAsync()
    {
        if (_currentUserId <= 0) return;
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var today = AttendanceService.GetTodayDate();
            _todayDate = today;
            _todayAttendance = await AttendanceService.GetTodayAttendanceAsync(_currentUserId, today);
            _history = await AttendanceService.GetAttendanceHistoryAsync(_currentUserId, today.AddDays(-30), today);
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi tải dữ liệu chấm công: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCheckIn()
    {
        if (_currentUserId <= 0) return;
        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AttendanceService.CheckInAsync(_currentUserId);
            _successMessage = "Check-In thành công!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task HandleCheckOut()
    {
        if (_currentUserId <= 0) return;
        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AttendanceService.CheckOutAsync(_currentUserId);
            _successMessage = "Check-Out thành công!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Đúng giờ" => "badge-active",
            "Đi muộn" => "badge-inactive",
            "Về sớm" => "text-warning border-warning",
            "Đi muộn & Về sớm" => "badge-inactive",
            _ => "badge-department"
        };
    }
}
