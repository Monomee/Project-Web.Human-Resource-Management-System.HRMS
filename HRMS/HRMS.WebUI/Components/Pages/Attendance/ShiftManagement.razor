@code {
    private string _activeTab = "shifts";
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _successMessage;

    private List<ShiftDto> _shifts = new();
    private List<ShiftAssignmentDto> _assignments = new();
    private List<(int Id, string EmployeeCode, string FullName, string DepartmentName)> _employees = new();

    private bool _showCreateShiftModal = false;
    private CreateShiftDto _createShiftDto = new();

    private bool _showEditShiftModal = false;
    private UpdateShiftDto? _editingShiftDto;

    private bool _showAssignShiftModal = false;
    private CreateShiftAssignmentDto _createAssignmentDto = new();

    private int _currentAccountId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentAccountIdAsync();
        await LoadDataAsync();
    }

    private async Task LoadCurrentAccountIdAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var accounts = await AccountService.GetAllAsync();
                var userEntity = accounts.FirstOrDefault(a => a.Username == user.Identity.Name);
                if (userEntity != null) _currentAccountId = userEntity.Id;
            }
        }
        catch
        {
            _currentAccountId = 0;
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _shifts = await AttendanceService.GetShiftsAsync();
            _assignments = await AttendanceService.GetShiftAssignmentsAsync();

            var allEmployees = await EmployeeService.GetEmployeesWithDetailsAsync();
            _employees = allEmployees
                .Where(u => u.Status)
                .Select(u => (u.Id, u.EmployeeCode, u.FullName, u.DepartmentName))
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi tải dữ liệu ca làm việc: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateShiftModal()
    {
        _createShiftDto = new CreateShiftDto
        {
            Name = "",
            StartTime = new TimeOnly(8, 0),
            EndTime = new TimeOnly(17, 30),
            BreakStart = new TimeOnly(12, 0),
            BreakEnd = new TimeOnly(13, 30),
            LateToleranceMinute = 15,
            EarlyCheckInMinute = 30,
            LateCheckOutMinute = 30,
            IsActive = true
        };
        _showCreateShiftModal = true;
    }

    private async Task CreateShiftAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AttendanceService.CreateShiftAsync(_createShiftDto);
            _successMessage = $"Tạo Ca làm việc '{_createShiftDto.Name}' thành công.";
            _showCreateShiftModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi tạo Ca làm việc: " + ex.Message;
        }
    }

    private void OpenEditShiftModal(ShiftDto shift)
    {
        _editingShiftDto = new UpdateShiftDto
        {
            Id = shift.Id,
            Name = shift.Name,
            StartTime = shift.StartTime,
            EndTime = shift.EndTime,
            BreakStart = shift.BreakStart,
            BreakEnd = shift.BreakEnd,
            LateToleranceMinute = shift.LateToleranceMinute,
            EarlyCheckInMinute = shift.EarlyCheckInMinute,
            LateCheckOutMinute = shift.LateCheckOutMinute,
            IsActive = shift.IsActive
        };
        _showEditShiftModal = true;
    }

    private async Task UpdateShiftAsync()
    {
        if (_editingShiftDto == null) return;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AttendanceService.UpdateShiftAsync(_editingShiftDto);
            _successMessage = $"Cập nhật Ca làm việc '{_editingShiftDto.Name}' thành công.";
            _showEditShiftModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi cập nhật Ca làm việc: " + ex.Message;
        }
    }

    private async Task DeactivateShift(int shiftId)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AttendanceService.DeleteShiftAsync(shiftId);
            _successMessage = "Đã vô hiệu hóa ca làm việc thành công.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi: " + ex.Message;
        }
    }

    private void OpenAssignShiftModal()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        _createAssignmentDto = new CreateShiftAssignmentDto
        {
            EmployeeId = 0,
            ShiftId = 0,
            StartDate = today,
            EndDate = today.AddDays(7)
        };
        _showAssignShiftModal = true;
    }

    private async Task AssignShiftAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AttendanceService.AssignShiftAsync(_createAssignmentDto, _currentAccountId);
            _successMessage = "Phân ca làm việc tạm thời cho nhân viên thành công.";
            _showAssignShiftModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi phân ca: " + ex.Message;
        }
    }

    private async Task DeleteAssignmentAsync(int assignmentId)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AttendanceService.DeleteShiftAssignmentAsync(assignmentId);
            _successMessage = "Xóa phân ca tạm thời thành công.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi xóa phân ca: " + ex.Message;
        }
    }

    private void SetTime(Action<TimeOnly> setter, string? val)
    {
        if (TimeOnly.TryParse(val, out var t)) setter(t);
    }

    private void SetDate(Action<DateOnly> setter, string? val)
    {
        if (DateOnly.TryParse(val, out var d)) setter(d);
    }
}
