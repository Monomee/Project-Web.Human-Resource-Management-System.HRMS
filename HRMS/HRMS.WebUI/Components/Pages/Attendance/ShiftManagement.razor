@page "/attendance/shifts"
@rendermode InteractiveServer

@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs.Attendance
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@attribute [Authorize(Roles = "Admin,HRM,HR")]
@inject IAttendanceService AttendanceService
@inject IAccountService AccountService
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Quản lý Ca & Phân ca — HRMS</PageTitle>

<div class="container-fluid mt-4">
    @* ── PAGE HEADER ── *@
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="page-title">
                <i class="bi bi-sliders me-2 text-primary"></i>Quản lý Ca & Phân ca làm việc
            </h2>
            <p class="page-subtitle">Cấu hình danh mục Ca làm việc và phân ca tạm thời cho nhân viên</p>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn-add-new" @onclick="OpenCreateShiftModal">
                <i class="bi bi-plus-circle me-1"></i>Thêm Ca làm việc
            </button>
            <button class="btn-cancel" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: white; border: none;" @onclick="OpenAssignShiftModal">
                <i class="bi bi-person-plus me-1"></i>Phân ca cho Nhân viên
            </button>
        </div>
    </div>

    @* ── ALERTS ── *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger-dark mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success-dark mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
            <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @* ── TAB TOOLBAR ── *@
    <div class="table-toolbar mb-0">
        <div class="d-flex align-items-center gap-3">
            <button class="tab-btn @(_activeTab == "shifts" ? "active" : "")" @onclick='() => _activeTab = "shifts"'>
                <i class="bi bi-clock me-2"></i>Danh sách Ca làm việc (@_shifts.Count)
            </button>
            <button class="tab-btn @(_activeTab == "assignments" ? "active" : "")" @onclick='() => _activeTab = "assignments"'>
                <i class="bi bi-person-lines-fill me-2"></i>Phân ca tạm thời (@_assignments.Count)
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="card-dark p-5 text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted-light">Đang tải dữ liệu ca làm việc...</p>
        </div>
    }
    else
    {
        @* ── TAB 1: DANH SÁCH CA LÀM VIỆC ── *@
        @if (_activeTab == "shifts")
        {
            <div class="card-dark mb-4">
                <div class="table-responsive">
                    <table class="table-dark-custom">
                        <thead>
                            <tr>
                                <th>Tên ca làm việc</th>
                                <th>Giờ làm việc</th>
                                <th>Giờ nghỉ trưa</th>
                                <th class="text-center">Dung sai trễ</th>
                                <th class="text-center">Check-in sớm</th>
                                <th class="text-center">Check-out muộn</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shift in _shifts)
                            {
                                <tr>
                                    <td><span class="employee-name-primary">@shift.Name</span></td>
                                    <td>
                                        <span class="badge-dark badge-department text-primary font-monospace">
                                            <i class="bi bi-clock-history me-1"></i>@shift.StartTime.ToString("HH:mm") - @shift.EndTime.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge-dark badge-department font-monospace">
                                            @shift.BreakStart.ToString("HH:mm") - @shift.BreakEnd.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td class="text-center text-muted-light">@shift.LateToleranceMinute phút</td>
                                    <td class="text-center text-muted-light">@shift.EarlyCheckInMinute phút</td>
                                    <td class="text-center text-muted-light">@shift.LateCheckOutMinute phút</td>
                                    <td class="text-center">
                                        @if (shift.IsActive)
                                        {
                                            <span class="badge-dark badge-active">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge-dark badge-inactive">Vô hiệu</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="action-icons justify-content-center">
                                            <button class="icon-btn icon-edit" @onclick="() => OpenEditShiftModal(shift)" title="Sửa ca làm việc">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            @if (shift.IsActive)
                                            {
                                                <button class="icon-btn text-danger" style="background: rgba(239, 68, 68, 0.15); color: #f87171;" @onclick="() => DeactivateShift(shift.Id)" title="Vô hiệu hóa ca này">
                                                    <i class="bi bi-slash-circle-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ── TAB 2: PHÂN CA TẠM THỜI ── *@
        @if (_activeTab == "assignments")
        {
            <div class="card-dark mb-4">
                <div class="table-responsive">
                    <table class="table-dark-custom">
                        <thead>
                            <tr>
                                <th>Mã NV</th>
                                <th>Họ và Tên</th>
                                <th>Ca được phân</th>
                                <th>Từ ngày</th>
                                <th>Đến ngày</th>
                                <th>Ngày phân ca</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_assignments.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted-light">
                                        Chưa có phân ca tạm thời nào.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var assignment in _assignments)
                                {
                                    <tr>
                                        <td><span class="badge-dark badge-department font-monospace">@assignment.EmployeeCode</span></td>
                                        <td><span class="employee-name-primary">@assignment.EmployeeName</span></td>
                                        <td><span class="badge-dark badge-active">@assignment.ShiftName</span></td>
                                        <td><span class="text-info font-monospace">@assignment.StartDate.ToString("dd/MM/yyyy")</span></td>
                                        <td><span class="text-warning font-monospace">@assignment.EndDate.ToString("dd/MM/yyyy")</span></td>
                                        <td><span class="text-muted-light font-monospace">@assignment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></td>
                                        <td class="text-center">
                                            <button class="icon-btn text-danger" style="background: rgba(239, 68, 68, 0.15); color: #f87171;" @onclick="() => DeleteAssignmentAsync(assignment.Id)" title="Xóa phân ca">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@* ── MODAL THÊM CA LÀM VIỆC ── *@
@if (_showCreateShiftModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="card-dark-form modal-content p-4" style="border: 1px solid rgba(255,255,255,0.15);">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <h5 class="text-white fw-bold mb-0">
                        <i class="bi bi-plus-circle me-2 text-primary"></i>Thêm Ca làm việc mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showCreateShiftModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="mb-3">
                        <label class="form-label-dark">Tên Ca làm việc <span class="text-danger">*</span></label>
                        <input type="text" class="form-control-dark" placeholder="VD: Ca Hành Chính Standard, Ca Đêm..." @bind="_createShiftDto.Name" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label-dark text-success">Giờ bắt đầu ca</label>
                            <input type="time" class="form-control-dark" value="@_createShiftDto.StartTime.ToString("HH:mm")" @onchange='e => SetTime(t => _createShiftDto.StartTime = t, e.Value?.ToString())' />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-dark text-info">Giờ kết thúc ca</label>
                            <input type="time" class="form-control-dark" value="@_createShiftDto.EndTime.ToString("HH:mm")" @onchange='e => SetTime(t => _createShiftDto.EndTime = t, e.Value?.ToString())' />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label-dark">Giờ bắt đầu nghỉ trưa</label>
                            <input type="time" class="form-control-dark" value="@_createShiftDto.BreakStart.ToString("HH:mm")" @onchange='e => SetTime(t => _createShiftDto.BreakStart = t, e.Value?.ToString())' />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-dark">Giờ kết thúc nghỉ trưa</label>
                            <input type="time" class="form-control-dark" value="@_createShiftDto.BreakEnd.ToString("HH:mm")" @onchange='e => SetTime(t => _createShiftDto.BreakEnd = t, e.Value?.ToString())' />
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label-dark">Dung sai trễ (phút)</label>
                            <input type="number" class="form-control-dark" @bind="_createShiftDto.LateToleranceMinute" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-dark">Check-in sớm (phút)</label>
                            <input type="number" class="form-control-dark" @bind="_createShiftDto.EarlyCheckInMinute" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-dark">Check-out muộn (phút)</label>
                            <input type="number" class="form-control-dark" @bind="_createShiftDto.LateCheckOutMinute" />
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn-cancel" @onclick="() => _showCreateShiftModal = false">Hủy</button>
                    <button type="button" class="btn-save" @onclick="CreateShiftAsync">
                        <i class="bi bi-check-circle me-1"></i>Tạo Ca
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── MODAL SỬA CA LÀM VIỆC ── *@
@if (_showEditShiftModal && _editingShiftDto != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="card-dark-form modal-content p-4" style="border: 1px solid rgba(255,255,255,0.15);">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <h5 class="text-white fw-bold mb-0">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>Chỉnh sửa Ca làm việc
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showEditShiftModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="mb-3">
                        <label class="form-label-dark">Tên Ca làm việc</label>
                        <input type="text" class="form-control-dark" @bind="_editingShiftDto.Name" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label-dark text-success">Giờ bắt đầu ca</label>
                            <input type="time" class="form-control-dark" value="@_editingShiftDto.StartTime.ToString("HH:mm")" @onchange='e => SetTime(t => _editingShiftDto.StartTime = t, e.Value?.ToString())' />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-dark text-info">Giờ kết thúc ca</label>
                            <input type="time" class="form-control-dark" value="@_editingShiftDto.EndTime.ToString("HH:mm")" @onchange='e => SetTime(t => _editingShiftDto.EndTime = t, e.Value?.ToString())' />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label-dark">Giờ bắt đầu nghỉ trưa</label>
                            <input type="time" class="form-control-dark" value="@_editingShiftDto.BreakStart.ToString("HH:mm")" @onchange='e => SetTime(t => _editingShiftDto.BreakStart = t, e.Value?.ToString())' />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-dark">Giờ kết thúc nghỉ trưa</label>
                            <input type="time" class="form-control-dark" value="@_editingShiftDto.BreakEnd.ToString("HH:mm")" @onchange='e => SetTime(t => _editingShiftDto.BreakEnd = t, e.Value?.ToString())' />
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label-dark">Dung sai trễ (phút)</label>
                            <input type="number" class="form-control-dark" @bind="_editingShiftDto.LateToleranceMinute" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-dark">Check-in sớm (phút)</label>
                            <input type="number" class="form-control-dark" @bind="_editingShiftDto.EarlyCheckInMinute" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-dark">Check-out muộn (phút)</label>
                            <input type="number" class="form-control-dark" @bind="_editingShiftDto.LateCheckOutMinute" />
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn-cancel" @onclick="() => _showEditShiftModal = false">Hủy</button>
                    <button type="button" class="btn-save" @onclick="UpdateShiftAsync">
                        <i class="bi bi-check-circle me-1"></i>Lưu thay đổi
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── MODAL PHÂN CA CHO NHÂN VIÊN ── *@
@if (_showAssignShiftModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="card-dark-form modal-content p-4" style="border: 1px solid rgba(255,255,255,0.15);">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <h5 class="text-white fw-bold mb-0">
                        <i class="bi bi-person-plus me-2 text-primary"></i>Phân ca làm việc tạm thời
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showAssignShiftModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="mb-3">
                        <label class="form-label-dark">Chọn Nhân viên <span class="text-danger">*</span></label>
                        <select class="filter-select w-100" @bind="_createAssignmentDto.EmployeeId">
                            <option value="0">-- Chọn nhân viên --</option>
                            @foreach (var emp in _employees)
                            {
                                <option value="@emp.Id">@emp.EmployeeCode - @emp.FullName (@emp.DepartmentName)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-dark">Chọn Ca làm việc <span class="text-danger">*</span></label>
                        <select class="filter-select w-100" @bind="_createAssignmentDto.ShiftId">
                            <option value="0">-- Chọn ca làm việc --</option>
                            @foreach (var s in _shifts.Where(x => x.IsActive))
                            {
                                <option value="@s.Id">@s.Name (@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm"))</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label-dark">Từ ngày <span class="text-danger">*</span></label>
                            <input type="date" class="form-control-dark" value="@_createAssignmentDto.StartDate.ToString("yyyy-MM-dd")" @onchange='e => SetDate(d => _createAssignmentDto.StartDate = d, e.Value?.ToString())' />
                        </div>
                        <div class="col-6">
                            <label class="form-label-dark">Đến ngày <span class="text-danger">*</span></label>
                            <input type="date" class="form-control-dark" value="@_createAssignmentDto.EndDate.ToString("yyyy-MM-dd")" @onchange='e => SetDate(d => _createAssignmentDto.EndDate = d, e.Value?.ToString())' />
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn-cancel" @onclick="() => _showAssignShiftModal = false">Hủy</button>
                    <button type="button" class="btn-save" @onclick="AssignShiftAsync">
                        <i class="bi bi-check-circle me-1"></i>Lưu Phân ca
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .page-title { color: #f1f5f9; font-size: 1.75rem; font-weight: 600; margin-bottom: 0.5rem; }
    .page-subtitle { color: #94a3b8; font-size: 0.95rem; margin-bottom: 0; }
    .text-muted-light { color: #94a3b8 !important; }

    .table-toolbar {
        padding: 1rem 1.5rem;
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px 12px 0 0;
        backdrop-filter: blur(12px);
    }

    .tab-btn {
        background: transparent; border: none; color: #94a3b8; font-weight: 500; font-size: 0.95rem;
        padding: 0.5rem 1rem; border-radius: 8px; transition: all 0.2s ease; cursor: pointer;
    }
    .tab-btn:hover { color: #f1f5f9; background: rgba(255, 255, 255, 0.05); }
    .tab-btn.active { color: #60a5fa; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); }

    .btn-add-new {
        height: 42px; padding: 0 1.5rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        border: none; border-radius: 8px; color: white;
        font-weight: 500; font-size: 0.9rem; cursor: pointer;
        display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.2s ease;
    }
    .btn-add-new:hover { background: linear-gradient(135deg, #2563eb, #1d4ed8); transform: translateY(-2px); }

    .card-dark {
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0 0 12px 12px; border-top: none;
        backdrop-filter: blur(12px); padding: 0; overflow: hidden;
    }

    .card-dark-form {
        background: rgba(20, 23, 38, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px; backdrop-filter: blur(16px);
    }

    .form-label-dark { color: #cbd5e1; font-weight: 500; font-size: 0.85rem; margin-bottom: 0.4rem; display: block; }
    .form-control-dark {
        width: 100%; height: 42px; padding: 0.5rem 1rem;
        background: rgba(30, 41, 59, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px; color: #e2e8f0 !important; font-size: 0.9rem;
    }

    .filter-select {
        height: 42px; padding: 0.5rem 2rem 0.5rem 0.75rem;
        background: rgba(30, 41, 59, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px; color: #e2e8f0 !important; font-size: 0.9rem;
    }
    .filter-select option { background: #1e293b; color: #e2e8f0; }

    .table-dark-custom { width: 100%; margin-bottom: 0; color: #e2e8f0; border-collapse: separate; border-spacing: 0; }
    .table-dark-custom thead { background: rgba(30, 41, 59, 0.8); }
    .table-dark-custom thead th { padding: 1rem 1.25rem; font-weight: 600; font-size: 0.875rem; text-transform: uppercase; color: #cbd5e1; border: none; }
    .table-dark-custom tbody tr { border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: background-color 0.2s ease; }
    .table-dark-custom tbody tr:hover { background: rgba(51, 65, 85, 0.4); }
    .table-dark-custom tbody td { padding: 0.9rem 1.25rem; vertical-align: middle; border: none; }

    .employee-name-primary { color: #f1f5f9; font-weight: 600; }
    .badge-dark { padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.8125rem; font-weight: 500; display: inline-flex; align-items: center; }
    .badge-department { background: rgba(51, 65, 85, 0.5); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.05); }
    .badge-active { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
    .badge-inactive { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    .action-icons { display: flex; align-items: center; gap: 0.5rem; }
    .icon-btn { width: 34px; height: 34px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; border: none; cursor: pointer; transition: all 0.2s ease; }
    .icon-edit { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }

    .btn-cancel { height: 42px; padding: 0 1.25rem; background: rgba(51, 65, 85, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #cbd5e1; font-weight: 500; display: inline-flex; align-items: center; cursor: pointer; }
