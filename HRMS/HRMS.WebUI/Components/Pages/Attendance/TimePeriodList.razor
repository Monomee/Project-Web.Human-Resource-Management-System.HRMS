@page "/attendance/periods"
@rendermode InteractiveServer

@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs.TimePeriod
@inject ITimePeriodService TimePeriodService
@inject NavigationManager Navigation

<PageTitle>Quản lý Kỳ công — HRMS</PageTitle>

<div class="container-fluid mt-4">
    @* ── HEADER TRANG ── *@
    <div class="row mb-4">
        <div class="col">
            <h2 class="page-title">
                <i class="bi bi-calendar-range-fill me-2 text-primary"></i>Quản lý Kỳ công
            </h2>
            <p class="page-subtitle">Tạo, cập nhật và khóa sổ các kỳ tính công hàng tháng cho toàn bộ doanh nghiệp</p>
        </div>
    </div>

    @* ── BANNER THÔNG BÁO LỖI / THÀNH CÔNG ── *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger-dark mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success-dark mb-3">
            <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
            <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-3 text-muted-light">Đang tải danh sách kỳ công...</p>
        </div>
    }
    else
    {
        @* ── TABLE TOOLBAR ── *@
        <div class="table-toolbar mb-0">
            <div class="toolbar-left">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-dark badge-department">
                        <i class="bi bi-calendar-event me-1"></i>Tổng số: @_periods.Count kỳ công
                    </span>
                </div>
            </div>

            <div class="toolbar-right">
                <a class="btn-add-new text-decoration-none" href="/attendance/periods/create">
                    <i class="bi bi-plus-circle me-2"></i>Tạo kỳ công mới
                </a>
            </div>
        </div>

        @* ── BẢNG DANH SÁCH KỲ CÔNG (DARK GLASSMORPHIC TABLE) ── *@
        <div class="card-dark mb-4">
            @if (_periods.Count == 0)
            {
                <div class="text-center py-5 text-muted-light">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-muted"></i>
                    <p class="mb-2">Chưa có kỳ công nào trong hệ thống.</p>
                    <a class="btn-add-new text-decoration-none d-inline-flex" href="/attendance/periods/create">
                        <i class="bi bi-plus-circle me-2"></i>Tạo kỳ công đầu tiên
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-dark-custom">
                        <thead>
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>Tên kỳ công</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th class="text-center">Số ngày công</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center" style="width: 200px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < _periods.Count; i++)
                            {
                                var p = _periods[i];
                                var rowNum = i + 1;
                                <tr class="@(p.IsLocked ? "opacity-75" : "")">
                                    <td class="text-muted font-monospace">@rowNum</td>
                                    <td>
                                        <div class="employee-name-primary fs-6">@p.Name</div>
                                    </td>
                                    <td>
                                        <span class="badge-dark badge-department font-monospace">
                                            <i class="bi bi-calendar-check me-1 text-info"></i>@p.StartDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge-dark badge-department font-monospace">
                                            <i class="bi bi-calendar-x me-1 text-warning"></i>@p.EndDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted-light fw-semibold">
                                            @(p.EndDate.DayNumber - p.StartDate.DayNumber + 1) ngày
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (p.IsLocked)
                                        {
                                            <span class="badge-dark badge-inactive">
                                                <i class="bi bi-lock-fill me-1"></i>Đã khóa sổ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-dark badge-active">
                                                <i class="bi bi-check-circle-fill me-1"></i>Đang mở
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="action-icons justify-content-center">
                                            @if (!p.IsLocked)
                                            {
                                                <a class="icon-btn icon-edit text-decoration-none"
                                                   href="/attendance/periods/edit/@p.Id"
                                                   title="Chỉnh sửa kỳ công">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                                <button class="icon-btn text-danger"
                                                        style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);"
                                                        @onclick="() => ToggleLockAsync(p, true)"
                                                        title="Khóa sổ kỳ công này">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="icon-btn text-success"
                                                        style="background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3);"
                                                        @onclick="() => ToggleLockAsync(p, false)"
                                                        title="Mở khóa kỳ công này">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<style>
    /* ============================================
       DARK THEME FOR ATTENDANCE MANAGEMENT
       ============================================ */
    .page-title {
        color: #f1f5f9;
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #94a3b8;
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    .text-muted-light {
        color: #94a3b8 !important;
    }

    /* Table Toolbar */
    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px 12px 0 0;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    /* Add New Button */
    .btn-add-new {
        height: 42px;
        padding: 0 1.5rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
    }

    .btn-add-new:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(59, 130, 246, 0.3);
    }

    /* Card Dark */
    .card-dark {
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0 0 12px 12px;
        border-top: none;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 0;
        overflow: hidden;
    }

    /* Table Dark Custom */
    .table-dark-custom {
        width: 100%;
        margin-bottom: 0;
        color: #e2e8f0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-dark-custom thead {
        background: rgba(30, 41, 59, 0.8);
        border-bottom: 2px solid rgba(100, 116, 139, 0.3);
    }

    .table-dark-custom thead th {
        padding: 1rem 1.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #cbd5e1;
        border: none;
    }

    .table-dark-custom tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: background-color 0.2s ease;
    }

    .table-dark-custom tbody tr:hover {
        background: rgba(51, 65, 85, 0.4);
    }

    .table-dark-custom tbody td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border: none;
    }

    .employee-name-primary {
        color: #f1f5f9;
        font-weight: 600;
    }

    /* Badges Dark */
    .badge-dark {
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
    }

    .badge-department {
        background: rgba(51, 65, 85, 0.5);
        color: #cbd5e1;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .badge-active {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .badge-inactive {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    /* Action Buttons */
    .action-icons {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .icon-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.9rem;
    }

    .icon-edit {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .icon-edit:hover {
        background: rgba(59, 130, 246, 0.3);
        color: #93c5fd;
        transform: translateY(-2px);
    }

    /* Dark Alerts */
    .alert-danger-dark {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
    }

    .alert-success-dark {
        background: rgba(34, 197, 94, 0.15);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.3);
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
    }
</style>

@code {
    private List<TimesheetPeriodDto> _periods = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _periods = await TimePeriodService.GetAllAsync();
        _isLoading = false;
    }

    private async Task ToggleLockAsync(TimesheetPeriodDto period, bool lockPeriod)
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            if (lockPeriod)
            {
                await TimePeriodService.LockPeriodAsync(period.Id);
                _successMessage = $"Đã khóa thành công kỳ công '{period.Name}'.";
            }
            else
            {
                await TimePeriodService.UnlockPeriodAsync(period.Id);
                _successMessage = $"Đã mở khóa thành công kỳ công '{period.Name}'.";
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi xử lý khóa kỳ công: " + ex.Message;
        }
    }
}
