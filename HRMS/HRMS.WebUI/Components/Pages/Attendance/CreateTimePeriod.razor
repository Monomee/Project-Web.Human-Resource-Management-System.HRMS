@page "/attendance/periods/create"
@rendermode InteractiveServer

@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs.TimePeriod
@inject ITimePeriodService TimePeriodService
@inject NavigationManager Navigation

<PageTitle>Tạo Kỳ công Mới — HRMS</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7 col-xl-6">

            <div class="mb-4">
                <a class="btn-back text-decoration-none d-inline-flex align-items-center mb-3" href="/attendance/periods">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                </a>
                <h2 class="page-title">
                    <i class="bi bi-calendar-plus-fill me-2 text-primary"></i>Tạo Kỳ công Mới
                </h2>
                <p class="page-subtitle">Tạo kỳ tính công mới để phục vụ quá trình chấm công và tính lương</p>
            </div>

            @if (_errorMessage != null)
            {
                <div class="alert alert-danger-dark mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                    <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _errorMessage = null"></button>
                </div>
            }

            <div class="card-dark-form p-4">
                <EditForm Model="_createDto" OnValidSubmit="HandleSubmit" FormName="create-period-page-form">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="form-label-dark">
                            Tên kỳ công <span class="text-danger">*</span>
                        </label>
                        <InputText class="form-control-dark"
                                   placeholder="Ví dụ: Tháng 07/2026"
                                   @bind-Value="_createDto.Name" />
                        <ValidationMessage For="() => _createDto.Name" class="text-danger small mt-1" />
                        <div class="form-hint-dark">Tên đại diện phân biệt kỳ công (VD: Tháng 07/2026, Kỳ I/2026...).</div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label-dark">
                                Ngày bắt đầu <span class="text-danger">*</span>
                            </label>
                            <InputDate class="form-control-dark" @bind-Value="_createDto.StartDate" />
                            <ValidationMessage For="() => _createDto.StartDate" class="text-danger small mt-1" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-dark">
                                Ngày kết thúc <span class="text-danger">*</span>
                            </label>
                            <InputDate class="form-control-dark" @bind-Value="_createDto.EndDate" />
                            <ValidationMessage For="() => _createDto.EndDate" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary border-opacity-25">
                        <a class="btn-cancel text-decoration-none" href="/attendance/periods">Hủy bỏ</a>
                        <button type="submit" class="btn-save" disabled="@_isSubmitting">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-1"></i>
                                <span>Lưu Kỳ công</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>

        </div>
    </div>
</div>

<style>
    .page-title {
        color: #f1f5f9;
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #94a3b8;
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    .btn-back {
        color: #94a3b8;
        font-size: 0.9rem;
        transition: color 0.2s;
    }
    .btn-back:hover {
        color: #38bdf8;
    }

    .card-dark-form {
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .form-label-dark {
        color: #cbd5e1;
        font-weight: 500;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control-dark {
        width: 100%;
        height: 42px;
        padding: 0.5rem 1rem;
        background: rgba(30, 41, 59, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #e2e8f0 !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .form-control-dark:focus {
        background: rgba(30, 41, 59, 0.8) !important;
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .form-hint-dark {
        color: #64748b;
        font-size: 0.8rem;
        margin-top: 0.4rem;
    }

    .btn-cancel {
        height: 42px;
        padding: 0 1.25rem;
        background: rgba(51, 65, 85, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #cbd5e1;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }
    .btn-cancel:hover {
        background: rgba(51, 65, 85, 0.8);
        color: white;
    }

    .btn-save {
        height: 42px;
        padding: 0 1.5rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
    }
    .btn-save:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        transform: translateY(-2px);
    }

    .alert-danger-dark {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
    }
</style>

@code {
    private CreateTimesheetPeriodDto _createDto = new()
    {
        Name = $"Tháng {DateTime.Now.Month:D2}/{DateTime.Now.Year}",
        StartDate = DateOnly.FromDateTime(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)),
        EndDate = DateOnly.FromDateTime(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1))
    };

    private string? _errorMessage;
    private bool _isSubmitting = false;

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            await TimePeriodService.CreateAsync(_createDto);
            Navigation.NavigateTo("/attendance/periods");
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra trong quá trình lưu dữ liệu: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
