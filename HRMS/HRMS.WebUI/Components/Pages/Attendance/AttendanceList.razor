@page "/attendance/list"
@page "/attendance/logs"
@rendermode InteractiveServer

@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs.Attendance
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims

@attribute [Authorize(Roles = "Admin,HRM,HR,Manager")]
@inject IAttendanceService AttendanceService
@inject IApplicationDbContext DbContext

<PageTitle>Quản lý Chấm công — HRMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-primary mb-1">
                <i class="bi bi-calendar2-check-fill me-2"></i>Bảng Quản lý Chấm công
            </h2>
            <p class="text-muted mb-0">Xem kết quả chấm công động (Đi muộn, Về sớm, OT) và chỉnh sửa giờ vào/ra của nhân sự.</p>
        </div>
        <div>
            <NavLink href="attendance/shifts" class="btn btn-outline-primary shadow-sm me-2">
                <i class="bi bi-sliders me-1"></i>Quản lý Ca làm việc
            </NavLink>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    <!-- FILTERS -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">📅 Kỳ công</label>
                    <select class="form-select" value="@_selectedPeriodId" @onchange="OnPeriodSelected">
                        <option value="0">-- Tất cả kỳ công --</option>
                        @foreach (var p in _periods)
                        {
                            <option value="@p.Id">@p.Name (@p.StartDate.ToString("dd/MM") - @p.EndDate.ToString("dd/MM/yyyy"))</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Từ ngày</label>
                    <input type="date" class="form-control" value="@_startDate?.ToString("yyyy-MM-dd")"
                           @onchange='e => SetDateOnly(d => _startDate = d, e.Value?.ToString())' />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Đến ngày</label>
                    <input type="date" class="form-control" value="@_endDate?.ToString("yyyy-MM-dd")"
                           @onchange='e => SetDateOnly(d => _endDate = d, e.Value?.ToString())' />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Phòng ban</label>
                    <select class="form-select" @bind="_selectedDepartmentId">
                        <option value="0">-- Tất cả phòng ban --</option>
                        @foreach (var dept in _departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end pt-3">
                    <button class="btn btn-primary w-100 shadow-sm" @onclick="FilterDataAsync">
                        <i class="bi bi-search me-1"></i> Lọc dữ liệu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Đang tải danh sách chấm công...</p>
                </div>
            }
            else if (!_attendances.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Không có bản ghi chấm công nào phù hợp với bộ lọc.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày</th>
                                <th>Mã NV</th>
                                <th>Họ và Tên</th>
                                <th>Phòng ban</th>
                                <th>Ca làm việc</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th class="text-center">Số phút làm</th>
                                <th class="text-center">Đi muộn</th>
                                <th class="text-center">Về sớm</th>
                                <th class="text-center">Làm OT</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _attendances)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.AttendanceDate.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold">@item.EmployeeCode</td>
                                    <td>@item.EmployeeName</td>
                                    <td><span class="badge bg-light text-dark border">@item.DepartmentName</span></td>
                                    <td><span class="badge bg-secondary">@item.ShiftName</span></td>
                                    <td class="text-success fw-bold">@(item.CheckInTime?.ToString("HH:mm:ss") ?? "-")</td>
                                    <td class="text-info fw-bold">@(item.CheckOutTime?.ToString("HH:mm:ss") ?? "-")</td>
                                    <td class="text-center">@item.WorkingMinutes phút</td>
                                    <td class="text-center">
                                        @if (item.LateMinutes > 0)
                                        {
                                            <span class="badge bg-danger">@item.LateMinutes phút</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.EarlyLeaveMinutes > 0)
                                        {
                                            <span class="badge bg-warning text-dark">@item.EarlyLeaveMinutes phút</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.OvertimeMinutes > 0)
                                        {
                                            <span class="badge bg-success">@item.OvertimeMinutes phút</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @GetStatusBadgeClass(item.Status)">@item.Status</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(item)">
                                            <i class="bi bi-pencil-square me-1"></i>Sửa giờ
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL SỬA GIỜ CHẤM CÔNG -->
@if (_showEditModal && _editingItem != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa giờ chấm công
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showEditModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="row">
                            <div class="col-6"><strong>Nhân viên:</strong> @_editingItem.EmployeeName</div>
                            <div class="col-6"><strong>Mã NV:</strong> @_editingItem.EmployeeCode</div>
                            <div class="col-6 mt-2"><strong>Ngày:</strong> @_editingItem.AttendanceDate.ToString("dd/MM/yyyy")</div>
                            <div class="col-6 mt-2"><strong>Ca làm việc:</strong> @_editingItem.ShiftName</div>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold text-success">Giờ Check-In</label>
                            <input type="time" class="form-control" value="@(_editingItem.CheckInTime?.ToString("HH:mm:ss"))"
                                   @onchange='e => SetTimeOnly(t => _editingItem.CheckInTime = t, e.Value?.ToString())' />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold text-info">Giờ Check-Out</label>
                            <input type="time" class="form-control" value="@(_editingItem.CheckOutTime?.ToString("HH:mm:ss"))"
                                   @onchange='e => SetTimeOnly(t => _editingItem.CheckOutTime = t, e.Value?.ToString())' />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showEditModal = false">Hủy</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEditAsync">Lưu chỉnh sửa</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _successMessage;

    private DateOnly? _startDate = DateOnly.FromDateTime(DateTime.Now.AddDays(-30));
    private DateOnly? _endDate = DateOnly.FromDateTime(DateTime.Now);
    private int _selectedDepartmentId = 0;
    private int _selectedPeriodId = 0;

    private List<AttendanceDetailDto> _attendances = new();
    private List<(int Id, string Name)> _departments = new();
    private List<TimesheetPeriodDto> _periods = new();

    private bool _showEditModal = false;
    private AttendanceDetailDto? _editingItem;

    protected override async Task OnInitializedAsync()
    {
        _departments = DbContext.Departments
            .Select(d => new { d.Id, d.Name })
            .ToList()
            .Select(d => (d.Id, d.Name))
            .ToList();

        _periods = await AttendanceService.GetPeriodsAsync();

        await FilterDataAsync();
    }

    private async Task OnPeriodSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int periodId))
        {
            _selectedPeriodId = periodId;
            if (_selectedPeriodId > 0)
            {
                var period = _periods.FirstOrDefault(p => p.Id == _selectedPeriodId);
                if (period != null)
                {
                    _startDate = period.StartDate;
                    _endDate = period.EndDate;
                }
            }
            await FilterDataAsync();
        }
    }

    private async Task FilterDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _attendances = await AttendanceService.GetAttendanceHistoryAsync(
                null,
                _startDate,
                _endDate,
                _selectedDepartmentId > 0 ? _selectedDepartmentId : null,
                _selectedPeriodId > 0 ? _selectedPeriodId : null
            );
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi tải danh sách chấm công: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEditModal(AttendanceDetailDto item)
    {
        _editingItem = new AttendanceDetailDto
        {
            Id = item.Id,
            EmployeeId = item.EmployeeId,
            EmployeeCode = item.EmployeeCode,
            EmployeeName = item.EmployeeName,
            AttendanceDate = item.AttendanceDate,
            ShiftName = item.ShiftName,
            CheckInTime = item.CheckInTime,
            CheckOutTime = item.CheckOutTime
        };
        _showEditModal = true;
    }

    private async Task SaveEditAsync()
    {
        if (_editingItem == null) return;
        try
        {
            await AttendanceService.UpdateAttendanceAsync(_editingItem.Id, _editingItem.CheckInTime, _editingItem.CheckOutTime);
            _successMessage = $"Cập nhật giờ chấm công cho nhân viên {_editingItem.EmployeeName} thành công!";
            _showEditModal = false;
            await FilterDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SetDateOnly(Action<DateOnly?> setter, string? val)
    {
        if (DateOnly.TryParse(val, out var d)) setter(d);
        else if (string.IsNullOrEmpty(val)) setter(null);
    }

    private void SetTimeOnly(Action<TimeOnly?> setter, string? val)
    {
        if (TimeOnly.TryParse(val, out var t)) setter(t);
        else if (string.IsNullOrEmpty(val)) setter(null);
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Đủ công" => "bg-success",
        "Đi muộn" => "bg-danger",
        "Về sớm" => "bg-warning text-dark",
        "Đi muộn & Về sớm" => "bg-danger",
        "Chưa check-out" => "bg-info text-dark",
        "Vắng mặt" => "bg-secondary",
        _ => "bg-primary"
    };
}
