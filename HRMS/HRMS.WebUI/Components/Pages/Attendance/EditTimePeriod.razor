@page "/attendance/periods/edit/{id:int}"
@rendermode InteractiveServer

@using HRMS.Application.Interfaces
@using HRMS.Application.DTOs.TimePeriod
@inject ITimePeriodService TimePeriodService
@inject NavigationManager Navigation

<PageTitle>Sửa Kỳ công — HRMS</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7 col-xl-6">

            <div class="mb-4">
                <a class="btn-back text-decoration-none d-inline-flex align-items-center mb-3" href="/attendance/periods">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                </a>
                <h2 class="page-title">
                    <i class="bi bi-pencil-square me-2 text-primary"></i>Chỉnh sửa Kỳ công
                </h2>
                <p class="page-subtitle">Cập nhật thông tin chi tiết của kỳ tính công trong hệ thống</p>
            </div>

            @if (_errorMessage != null)
            {
                <div class="alert alert-danger-dark mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                    <button type="button" class="btn-close btn-close-white float-end" @onclick="() => _errorMessage = null"></button>
                </div>
            }

            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="mt-3 text-muted-light">Đang tải thông tin kỳ công...</p>
                </div>
            }
            else if (_periodDetail == null)
            {
                <div class="card-dark-form p-5 text-center">
                    <i class="bi bi-exclamation-circle text-warning fs-1 d-block mb-3"></i>
                    <p class="text-muted-light fs-5 mb-3">Không tìm thấy kỳ công yêu cầu hoặc dữ liệu không tồn tại.</p>
                    <div>
                        <a class="btn-cancel text-decoration-none d-inline-flex" href="/attendance/periods">Trở lại danh sách</a>
                    </div>
                </div>
            }
            else
            {
                @if (_periodDetail.IsLocked)
                {
                    <div class="alert alert-warning-dark mb-4">
                        <i class="bi bi-lock-fill me-2"></i>
                        <strong>Kỳ công đã bị khóa sổ:</strong> Kỳ công này đã bị đóng và không thể thay đổi thông tin. Vui lòng mở khóa trước khi chỉnh sửa.
                    </div>
                }

                <div class="card-dark-form p-4">
                    <EditForm Model="_editDto" OnValidSubmit="HandleSubmit" FormName="edit-period-page-form">
                        <DataAnnotationsValidator />

                        <div class="mb-4">
                            <label class="form-label-dark">
                                Tên kỳ công <span class="text-danger">*</span>
                            </label>
                            <InputText class="form-control-dark"
                                       placeholder="Ví dụ: Tháng 07/2026"
                                       disabled="@_periodDetail.IsLocked"
                                       @bind-Value="_editDto.Name" />
                            <ValidationMessage For="() => _editDto.Name" class="text-danger small mt-1" />
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label-dark">
                                    Ngày bắt đầu <span class="text-danger">*</span>
                                </label>
                                <InputDate class="form-control-dark" disabled="@_periodDetail.IsLocked" @bind-Value="_editDto.StartDate" />
                                <ValidationMessage For="() => _editDto.StartDate" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-dark">
                                    Ngày kết thúc <span class="text-danger">*</span>
                                </label>
                                <InputDate class="form-control-dark" disabled="@_periodDetail.IsLocked" @bind-Value="_editDto.EndDate" />
                                <ValidationMessage For="() => _editDto.EndDate" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary border-opacity-25">
                            <a class="btn-cancel text-decoration-none" href="/attendance/periods">Hủy bỏ</a>
                            <button type="submit" class="btn-save" disabled="@(_isSubmitting || _periodDetail.IsLocked)">
                                @if (_isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Đang lưu...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-1"></i>
                                    <span>Lưu thay đổi</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            }

        </div>
    </div>
</div>

<style>
    .page-title {
        color: #f1f5f9;
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #94a3b8;
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    .btn-back {
        color: #94a3b8;
        font-size: 0.9rem;
        transition: color 0.2s;
    }
    .btn-back:hover {
        color: #38bdf8;
    }

    .card-dark-form {
        background: rgba(20, 23, 38, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .form-label-dark {
        color: #cbd5e1;
        font-weight: 500;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control-dark {
        width: 100%;
        height: 42px;
        padding: 0.5rem 1rem;
        background: rgba(30, 41, 59, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #e2e8f0 !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .form-control-dark:focus {
        background: rgba(30, 41, 59, 0.8) !important;
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .btn-cancel {
        height: 42px;
        padding: 0 1.25rem;
        background: rgba(51, 65, 85, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #cbd5e1;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }
    .btn-cancel:hover {
        background: rgba(51, 65, 85, 0.8);
        color: white;
    }

    .btn-save {
        height: 42px;
        padding: 0 1.5rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
    }
    .btn-save:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        transform: translateY(-2px);
    }

    .alert-danger-dark {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
    }

    .alert-warning-dark {
        background: rgba(245, 158, 11, 0.15);
        color: #fcd34d;
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
    }
</style>

@code {
    [Parameter] public int id { get; set; }

    private TimesheetPeriodDto? _periodDetail;
    private UpdateTimesheetPeriodDto _editDto = new();
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPeriodDataAsync();
    }

    private async Task LoadPeriodDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _periodDetail = await TimePeriodService.GetByIdAsync(id);
            if (_periodDetail != null)
            {
                _editDto = new UpdateTimesheetPeriodDto
                {
                    Name = _periodDetail.Name,
                    StartDate = _periodDetail.StartDate,
                    EndDate = _periodDetail.EndDate
                };
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi tải dữ liệu kỳ công: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (_periodDetail != null && _periodDetail.IsLocked) return;

        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            await TimePeriodService.UpdateAsync(id, _editDto);
            Navigation.NavigateTo("/attendance/periods");
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra khi cập nhật kỳ công: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
